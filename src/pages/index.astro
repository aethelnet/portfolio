---
// index.astro - Aethelburg White Light Brutalism & Fullscreen Dynamic Systems Portfolio
import PhaseSpaceNavigator from '../components/PhaseSpaceNavigator.astro';
import ProjectIcon from '../components/ProjectIcon.astro';
import ProjectDossier from '../components/ProjectDossier.astro';
import ArcScrubberModal from '../components/ArcScrubberModal.astro';
import MuseumGraphModal from '../components/MuseumGraphModal.astro';
import LgnnSandboxModal from '../components/LgnnSandboxModal.astro';
import EdisonReplayModal from '../components/EdisonReplayModal.astro';
import VoltGridModal from '../components/VoltGridModal.astro';
import AudioEngineModal from '../components/AudioEngineModal.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="de" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AETHELBURG // Autonomous Neurosymbolics & Dynamical Systems</title>
    <meta name="description" content="Portfolio für autonome Neurosymbolik, kontinuierliche Liquid Neural Networks, ARC-AGI-3 World Models und Provenienz-Kartographie." />
    
    <!-- OpenGraph & Social Previews -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://aethelburg.info/" />
    <meta property="og:title" content="AETHELBURG // Autonomous Neurosymbolics & Dynamical Systems" />
    <meta property="og:description" content="Engineering lab for autonomous causal world models, real-time C++20 DSP engines, continuous liquid ODEs, and cyber-physical networks." />
    <meta property="og:image" content="https://aethelburg.info/og-preview.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="AETHELBURG // Autonomous Neurosymbolics & Dynamical Systems" />
    <meta name="twitter:description" content="Engineering lab for autonomous causal world models, real-time C++20 DSP engines, continuous liquid ODEs, and cyber-physical networks." />
    <meta name="twitter:image" content="https://aethelburg.info/og-preview.svg" />
    <link rel="canonical" href="https://aethelburg.info/" />
    
    <!-- Dutch & Swiss Typography Stack: Space Grotesk + Newsreader + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Newsreader:ital,opsz,wght@1,6..72,300;1,6..72,400;1,6..72,600&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="min-h-screen w-full relative overflow-hidden flex flex-col justify-between selection:bg-[var(--text-primary)] selection:text-[var(--bg-primary)]">
    
    <!-- 00 // Fullscreen Continuous Phase Space World Canvas -->
    <PhaseSpaceNavigator />

    <!-- 01 // Top Editorial Header -->
    <header class="relative z-10 w-full px-5 sm:px-10 py-5 flex items-center justify-between border-b border-[var(--border-hairline)] bg-[var(--bg-primary)]/80 backdrop-blur-md">
      <div class="flex items-center gap-4">
        <div class="w-2.5 h-2.5 bg-[var(--text-primary)]"></div>
        <div class="flex items-baseline gap-2">
          <span class="font-bold tracking-tight text-sm text-[var(--text-primary)] uppercase">AETHELBURG</span>
          <span class="text-[10px] font-mono-tech text-[var(--text-muted)] tracking-wider">[LAB-2026.09]</span>
        </div>
      </div>

      <!-- Real-Time Dynamic Coordinates Readout -->
      <div class="hidden md:flex items-center gap-3 font-mono-tech text-[11px] text-[var(--text-secondary)]">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span id="live-coordinates">h₁: +0.000 | h₂: +0.000</span>
        <span class="text-[var(--text-muted)] text-[10px]">// 60 FPS CONTINUOUS ODE</span>
      </div>

      <!-- Theme Switcher & Local Time -->
      <div class="flex items-center gap-4 font-mono-tech text-xs">
        <div class="hidden sm:block text-[11px] text-[var(--text-muted)]" id="clock-display">
          BERLIN --:--:--
        </div>
        <button id="theme-toggle-btn" class="px-2.5 py-1 rounded border border-[var(--border-hairline)] hover:border-[var(--text-primary)] text-[11px] font-mono-tech text-[var(--text-primary)] transition-all flex items-center gap-1.5 bg-[var(--bg-card)]">
          <span id="theme-icon">☾</span>
          <span id="theme-text">DARK</span>
        </button>
      </div>
    </header>

    <!-- 02 // Center Stage (Monumental Typography & Field Hint) -->
    <main class="relative z-10 px-5 sm:px-10 my-auto max-w-4xl pointer-events-none">
      <div class="space-y-4">
        <div class="text-[11px] font-mono-tech uppercase tracking-widest text-[var(--text-muted)]">
          // AUTONOME NEUROSYMBOLIK & ZEITKONTINUIERLICHE DYNAMIK
        </div>
        
        <h1 class="text-3xl sm:text-6xl font-bold tracking-tight text-[var(--text-primary)] leading-[1.08]">
          Architektur für <br />
          <span class="font-editorial font-normal italic text-[var(--text-secondary)]">fluide Intelligenz</span> &amp; Nichtlinearität.
        </h1>

        <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed max-w-xl">
          Wir modellieren kontinuierliche physikalische Zustandsräume statt diskreter Textmuster. 
          Bewege den Cursor, um das Vektorfeld zu krümmen – oder wähle einen Attraktor-Fixpunkt, um in das jeweilige Forschungs-Dossier zu spiralförmig einzutauchen.
        </p>
      </div>
    </main>

    <!-- 03 // Bottom Horizontal Project Attractor Reel -->
    <footer class="relative z-10 w-full px-5 sm:px-10 py-5 border-t border-[var(--border-hairline)] bg-[var(--bg-primary)]/80 backdrop-blur-md">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <!-- Waypoint Triggers (Horizontal Snap-Reel on Mobile, clean flex on desktop) -->
        <div class="flex items-center gap-2 sm:gap-2.5 text-xs font-mono-tech overflow-x-auto no-scrollbar max-w-full py-1">
          <span class="text-[10px] text-[var(--text-muted)] mr-1 uppercase shrink-0">ATTRAKTOREN:</span>
          
          <button class="waypoint-btn px-2.5 py-1.5 rounded border border-[var(--border-hairline)] hover:border-[var(--text-primary)] bg-[var(--bg-card)] text-[var(--text-primary)] hover:scale-[1.02] active:scale-95 transition-all cursor-pointer flex items-center gap-1.5 shrink-0" data-id="arc">
            <ProjectIcon id="arc" class="w-3.5 h-3.5 text-emerald-500" />
            <span>01 // ARC-AGI-3</span>
          </button>
          
          <button class="waypoint-btn px-2.5 py-1.5 rounded border border-[var(--border-hairline)] hover:border-[var(--text-primary)] bg-[var(--bg-card)] text-[var(--text-primary)] hover:scale-[1.02] active:scale-95 transition-all cursor-pointer flex items-center gap-1.5 shrink-0" data-id="museum">
            <ProjectIcon id="museum" class="w-3.5 h-3.5 text-amber-500" />
            <span>02 // SHADOW MUSEUM</span>
          </button>
          
          <button class="waypoint-btn px-2.5 py-1.5 rounded border border-[var(--border-hairline)] hover:border-[var(--text-primary)] bg-[var(--bg-card)] text-[var(--text-primary)] hover:scale-[1.02] active:scale-95 transition-all cursor-pointer flex items-center gap-1.5 shrink-0" data-id="edison">
            <ProjectIcon id="edison" class="w-3.5 h-3.5 text-cyan-500" />
            <span>03 // EDISON ENGINE</span>
          </button>
          
          <button class="waypoint-btn px-2.5 py-1.5 rounded border border-[var(--border-hairline)] hover:border-[var(--text-primary)] bg-[var(--bg-card)] text-[var(--text-primary)] hover:scale-[1.02] active:scale-95 transition-all cursor-pointer flex items-center gap-1.5 shrink-0" data-id="lgnn">
            <ProjectIcon id="lgnn" class="w-3.5 h-3.5 text-purple-500" />
            <span>04 // LIQUID ODE</span>
          </button>
          
          <button class="waypoint-btn px-2.5 py-1.5 rounded border border-[var(--border-hairline)] hover:border-[var(--text-primary)] bg-[var(--bg-card)] text-[var(--text-primary)] hover:scale-[1.02] active:scale-95 transition-all cursor-pointer flex items-center gap-1.5 shrink-0" data-id="volt">
            <ProjectIcon id="volt" class="w-3.5 h-3.5 text-amber-400" />
            <span>05 // VOLT GRID</span>
          </button>

          <button class="waypoint-btn px-2.5 py-1.5 rounded border border-[var(--border-hairline)] hover:border-[var(--text-primary)] bg-[var(--bg-card)] text-[var(--text-primary)] hover:scale-[1.02] active:scale-95 transition-all cursor-pointer flex items-center gap-1.5 shrink-0" data-id="audio">
            <ProjectIcon id="audio" class="w-3.5 h-3.5 text-rose-500" />
            <span>06 // AUDIO CORE</span>
          </button>
        </div>

        <!-- Meta & Links -->
        <div class="flex items-center gap-5 text-[11px] font-mono-tech text-[var(--text-muted)]">
          <a href="https://github.com/aethelnet" target="_blank" rel="noreferrer" class="hover:text-[var(--text-primary)] transition-colors">
            GITHUB ↗
          </a>
          <span>BERLIN // 52.5200° N, 13.4050° E</span>
        </div>
      </div>
    </footer>

    <!-- 04 // Slide-Over Project Dossier Component -->
    <ProjectDossier />

    <!-- 05 // Interactive ARC-AGI-3 Scrubber Modal -->
    <ArcScrubberModal />

    <!-- 06 // Interactive Shadow Museum Graph Modal -->
    <MuseumGraphModal />

    <!-- 07 // Interactive Liquid Neural ODE Sandbox Modal -->
    <LgnnSandboxModal />

    <!-- 08 // Interactive Edison Match Forensics Modal -->
    <EdisonReplayModal />

    <!-- 09 // Interactive VoltGrid Cyber-Physical Phasor Modal -->
    <VoltGridModal />

    <!-- 10 // Interactive Audio Engine Core DSP Modal -->
    <AudioEngineModal />

    <script>
      // Live Clock & Light/Dark Theme Controller
      function initIndex() {
        // 1. Clock
        const clockEl = document.getElementById('clock-display');
        function updateClock() {
          if (!clockEl) return;
          const now = new Date();
          clockEl.textContent = `BERLIN ${now.toLocaleTimeString('de-DE', { timeZone: 'Europe/Berlin' })}`;
        }
        setInterval(updateClock, 1000);
        updateClock();

        // 2. Theme Toggle (Light / Dark)
        const toggleBtn = document.getElementById('theme-toggle-btn');
        const themeIcon = document.getElementById('theme-icon');
        const themeText = document.getElementById('theme-text');
        const html = document.documentElement;

        // Check stored preference or default to light
        const storedTheme = localStorage.getItem('aethelburg-theme') || 'light';
        if (storedTheme === 'dark') {
          html.classList.add('dark');
          if (themeIcon) themeIcon.textContent = '☀';
          if (themeText) themeText.textContent = 'LIGHT';
        } else {
          html.classList.remove('dark');
          if (themeIcon) themeIcon.textContent = '☾';
          if (themeText) themeText.textContent = 'DARK';
        }

        toggleBtn?.addEventListener('click', () => {
          const isDark = html.classList.toggle('dark');
          localStorage.setItem('aethelburg-theme', isDark ? 'dark' : 'light');
          if (themeIcon) themeIcon.textContent = isDark ? '☀' : '☾';
          if (themeText) themeText.textContent = isDark ? 'LIGHT' : 'DARK';
        });

        // 3. Waypoint button event dispatchers
        document.querySelectorAll('.waypoint-btn').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const id = btn.getAttribute('data-id');
            window.dispatchEvent(new CustomEvent('select-waypoint', { detail: { id } }));
            window.dispatchEvent(new CustomEvent('open-dossier', { detail: { id } }));
          });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initIndex);
      } else {
        initIndex();
      }
    </script>
  </body>
</html>
