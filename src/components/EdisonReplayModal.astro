---
// EdisonReplayModal.astro - Interactive Match Forensics & Chain-Link Inspector (WASM OCGCore)
import ProjectIcon from './ProjectIcon.astro';
---

<div id="edison-replay-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-md flex items-center justify-center p-3 sm:p-5 opacity-0 pointer-events-none transition-opacity duration-300 font-mono-tech text-xs select-none">
  <div class="relative w-full max-w-6xl h-[90vh] bg-[var(--bg-primary)] border border-[var(--border-strong)] rounded-lg shadow-2xl overflow-hidden flex flex-col">
    
    <!-- Modal Header -->
    <div class="px-5 py-3 border-b border-[var(--border-hairline)] bg-[var(--bg-secondary)] flex items-center justify-between">
      <div class="flex items-center gap-3">
        <ProjectIcon id="edison" class="w-4 h-4 text-cyan-500 shrink-0" />
        <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
        <span class="font-bold text-[var(--text-primary)] tracking-wide">AURATIC PRIME // EDISON ENGINE (OCGCORE WASM)</span>
        <span class="text-[10px] text-[var(--text-muted)] hidden sm:inline">[MATCH FORENSIK: TISCH 01 // SWISS RUNDE 3]</span>
      </div>
      <div class="flex items-center gap-4">
        <!-- Fog of War / God Mode Toggle -->
        <button id="edison-fog-btn" class="px-2.5 py-1 rounded border border-[var(--border-hairline)] hover:border-[var(--text-primary)] bg-[var(--bg-card)] text-[10px] text-[var(--text-primary)] font-bold transition-all cursor-pointer flex items-center gap-1.5 shadow-sm">
          <span id="edison-fog-led" class="w-1.5 h-1.5 rounded-full bg-cyan-500"></span>
          <span id="edison-fog-label">GOD-MODE: UNMASKED</span>
        </button>

        <button id="edison-close-btn" class="px-2.5 py-1 rounded border border-[var(--border-hairline)] hover:border-[var(--text-primary)] text-[10px] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-all cursor-pointer">
          [SCHLIESSEN ✕]
        </button>
      </div>
    </div>

    <!-- Match Scenario Banner Strip -->
    <div class="px-5 py-2 border-b border-[var(--border-hairline)] bg-[var(--bg-primary)] flex flex-wrap items-center justify-between gap-3 text-[10px]">
      <div class="flex items-center gap-4 text-[var(--text-secondary)]">
        <div>MATCH: <strong class="text-[var(--text-primary)]">HERO BEAT (PILOT A)</strong> vs <strong class="text-[var(--text-primary)]">DIVA ZOMBIE (PILOT B)</strong></div>
        <div class="hidden md:inline">FORMAT: <span class="text-amber-600 dark:text-amber-400 font-bold">EDISON (APRIL 2010)</span></div>
      </div>
      <div class="flex items-center gap-3">
        <span class="text-[var(--text-muted)]">STATUS:</span>
        <span class="px-2 py-0.5 rounded bg-emerald-500/15 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 font-bold">
          KDE TIEBREAKER TURN 02 // TIME-CALL
        </span>
      </div>
    </div>

    <!-- Main Workspace (Dual Columns) -->
    <div class="relative flex-1 w-full h-full overflow-y-auto md:overflow-hidden flex flex-col md:flex-row">
      
      <!-- Left: Board Matrix & Life Point Field Stage -->
      <div class="relative flex-1 md:h-full bg-[var(--bg-primary)] p-4 flex flex-col justify-between overflow-y-auto space-y-4">
        
        <!-- Opponent (Pilot B - Diva Zombie) Status Bar -->
        <div class="p-3 rounded border border-[var(--border-hairline)] bg-[var(--bg-card)] space-y-2">
          <div class="flex justify-between items-center text-[10px]">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-purple-500"></span>
              <span class="font-bold text-[var(--text-primary)]">PILOT B (DIVA ZOMBIE)</span>
              <span class="text-[var(--text-muted)]">[P2]</span>
            </div>
            <div class="font-mono text-sm font-bold text-[var(--text-primary)]" id="edison-lp-p2">3,400 LP</div>
          </div>
          <!-- LP Bar -->
          <div class="w-full h-2 bg-[var(--bg-secondary)] rounded-full overflow-hidden border border-[var(--border-hairline)]">
            <div id="edison-lp-bar-p2" class="h-full bg-purple-500 transition-all duration-300" style="width: 42.5%;"></div>
          </div>
          <!-- Hand Cards Representation -->
          <div class="pt-1 flex items-center justify-between text-[10px] text-[var(--text-muted)]">
            <span>HAND: 3 KARTEN</span>
            <div id="edison-p2-hand-cards" class="flex gap-1.5">
              <span class="px-1.5 py-0.5 rounded border border-[var(--border-hairline)] bg-[var(--bg-secondary)] text-[var(--text-secondary)] card-reveal">Gorz the Emissary of Darkness</span>
              <span class="px-1.5 py-0.5 rounded border border-[var(--border-hairline)] bg-[var(--bg-secondary)] text-[var(--text-secondary)] card-reveal">Book of Moon</span>
              <span class="px-1.5 py-0.5 rounded border border-[var(--border-hairline)] bg-[var(--bg-secondary)] text-[var(--text-secondary)] card-reveal">Plaguespreader Zombie</span>
            </div>
          </div>
        </div>

        <!-- Interactive Board Grid Representation -->
        <div class="p-4 rounded border border-[var(--border-hairline)] bg-[var(--bg-secondary)] space-y-4 shadow-inner">
          
          <!-- P2 Field (Monsters & Spells) -->
          <div class="space-y-2">
            <div class="text-[9px] text-[var(--text-muted)] uppercase tracking-wider">Gegnerische Feldzone (Pilot B):</div>
            <!-- Monsters P2 -->
            <div class="grid grid-cols-5 gap-1 sm:gap-2 text-center text-[8px] sm:text-[10px]">
              <div class="p-1.5 sm:p-2 rounded border border-[var(--border-hairline)] bg-[var(--bg-card)] flex flex-col justify-center min-h-[48px] sm:min-h-[52px]">
                <div class="font-bold text-[var(--text-primary)] leading-tight truncate">Stardust Dragon</div>
                <div class="text-[8px] sm:text-[9px] text-[var(--text-muted)]">2500 / 2000</div>
              </div>
              <div class="p-1.5 sm:p-2 rounded border border-[var(--border-hairline)] bg-[var(--bg-card)] flex flex-col justify-center min-h-[48px] sm:min-h-[52px]">
                <div class="font-bold text-[var(--text-primary)] leading-tight truncate">Goyo Guardian</div>
                <div class="text-[8px] sm:text-[9px] text-[var(--text-muted)]">2800 / 2000</div>
              </div>
              <div class="p-1.5 sm:p-2 rounded border border-dashed border-[var(--border-hairline)] text-[var(--text-muted)] flex items-center justify-center min-h-[48px] sm:min-h-[52px]">LEER</div>
              <div class="p-1.5 sm:p-2 rounded border border-dashed border-[var(--border-hairline)] text-[var(--text-muted)] flex items-center justify-center min-h-[48px] sm:min-h-[52px]">LEER</div>
              <div class="p-1.5 sm:p-2 rounded border border-dashed border-[var(--border-hairline)] text-[var(--text-muted)] flex items-center justify-center min-h-[48px] sm:min-h-[52px]">LEER</div>
            </div>
            <!-- Backrow P2 -->
            <div class="grid grid-cols-5 gap-1 sm:gap-2 text-center text-[8px] sm:text-[10px]">
              <div id="card-starlight" class="p-1.5 sm:p-2 rounded border border-amber-500/50 bg-amber-500/10 flex flex-col justify-center min-h-[42px] sm:min-h-[46px] transition-all">
                <div class="font-bold text-amber-600 dark:text-amber-400 leading-tight truncate">Starlight Road</div>
                <div class="text-[8px] sm:text-[9px] text-[var(--text-muted)]">[CL2]</div>
              </div>
              <div class="p-1.5 sm:p-2 rounded border border-[var(--border-hairline)] bg-[var(--bg-card)] flex flex-col justify-center min-h-[42px] sm:min-h-[46px]">
                <div class="font-bold text-[var(--text-primary)] leading-tight card-reveal truncate">Bottomless Trap</div>
                <div class="text-[8px] sm:text-[9px] text-[var(--text-muted)]">Falle</div>
              </div>
              <div class="p-1.5 sm:p-2 rounded border border-dashed border-[var(--border-hairline)] text-[var(--text-muted)] flex items-center justify-center min-h-[42px] sm:min-h-[46px]">LEER</div>
              <div class="p-1.5 sm:p-2 rounded border border-dashed border-[var(--border-hairline)] text-[var(--text-muted)] flex items-center justify-center min-h-[42px] sm:min-h-[46px]">LEER</div>
              <div class="p-1.5 sm:p-2 rounded border border-dashed border-[var(--border-hairline)] text-[var(--text-muted)] flex items-center justify-center min-h-[42px] sm:min-h-[46px]">LEER</div>
            </div>
          </div>

          <!-- Central Conflict Horizon / Chain Resolution Arena -->
          <div class="py-2 px-3 rounded border border-dashed border-[var(--border-strong)] bg-[var(--bg-primary)] flex items-center justify-between text-[10px] sm:text-[11px]">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-cyan-500 animate-pulse"></span>
              <span class="font-bold text-[var(--text-primary)]">KETTEN-AUFLÖSUNG (LIFO ARENA):</span>
            </div>
            <div id="edison-chain-summary" class="font-bold text-cyan-600 dark:text-cyan-400">
              3 KETTENGLIEDER // AKTIV: CL3
            </div>
          </div>

          <!-- P1 Field (Hero Beat) -->
          <div class="space-y-2">
            <!-- Backrow P1 -->
            <div class="grid grid-cols-5 gap-1 sm:gap-2 text-center text-[8px] sm:text-[10px]">
              <div id="card-heavystorm" class="p-1.5 sm:p-2 rounded border border-emerald-500/50 bg-emerald-500/10 flex flex-col justify-center min-h-[42px] sm:min-h-[46px] transition-all">
                <div class="font-bold text-emerald-600 dark:text-emerald-400 leading-tight truncate">Heavy Storm</div>
                <div class="text-[8px] sm:text-[9px] text-[var(--text-muted)]">[CL1]</div>
              </div>
              <div id="card-solemn" class="p-1.5 sm:p-2 rounded border border-cyan-500/50 bg-cyan-500/10 flex flex-col justify-center min-h-[42px] sm:min-h-[46px] transition-all">
                <div class="font-bold text-cyan-600 dark:text-cyan-400 leading-tight truncate">Solemn Judgment</div>
                <div class="text-[8px] sm:text-[9px] text-[var(--text-muted)]">[CL3]</div>
              </div>
              <div class="p-1.5 sm:p-2 rounded border border-[var(--border-hairline)] bg-[var(--bg-card)] flex flex-col justify-center min-h-[42px] sm:min-h-[46px]">
                <div class="font-bold text-[var(--text-primary)] leading-tight truncate">D-Prison</div>
                <div class="text-[8px] sm:text-[9px] text-[var(--text-muted)]">Falle</div>
              </div>
              <div class="p-1.5 sm:p-2 rounded border border-dashed border-[var(--border-hairline)] text-[var(--text-muted)] flex items-center justify-center min-h-[42px] sm:min-h-[46px]">LEER</div>
              <div class="p-1.5 sm:p-2 rounded border border-dashed border-[var(--border-hairline)] text-[var(--text-muted)] flex items-center justify-center min-h-[42px] sm:min-h-[46px]">LEER</div>
            </div>
            <!-- Monsters P1 -->
            <div class="grid grid-cols-5 gap-1 sm:gap-2 text-center text-[8px] sm:text-[10px]">
              <div class="p-1.5 sm:p-2 rounded border border-[var(--border-hairline)] bg-[var(--bg-card)] flex flex-col justify-center min-h-[48px] sm:min-h-[52px]">
                <div class="font-bold text-[var(--text-primary)] leading-tight truncate">E-HERO Stratos</div>
                <div class="text-[8px] sm:text-[9px] text-[var(--text-muted)]">1800 / 300</div>
              </div>
              <div class="p-1.5 sm:p-2 rounded border border-[var(--border-hairline)] bg-[var(--bg-card)] flex flex-col justify-center min-h-[48px] sm:min-h-[52px]">
                <div class="font-bold text-[var(--text-primary)] leading-tight truncate">Neos Alius</div>
                <div class="text-[8px] sm:text-[9px] text-[var(--text-muted)]">1900 / 1300</div>
              </div>
              <div class="p-1.5 sm:p-2 rounded border border-dashed border-[var(--border-hairline)] text-[var(--text-muted)] flex items-center justify-center min-h-[48px] sm:min-h-[52px]">LEER</div>
              <div class="p-1.5 sm:p-2 rounded border border-dashed border-[var(--border-hairline)] text-[var(--text-muted)] flex items-center justify-center min-h-[48px] sm:min-h-[52px]">LEER</div>
              <div class="p-1.5 sm:p-2 rounded border border-dashed border-[var(--border-hairline)] text-[var(--text-muted)] flex items-center justify-center min-h-[48px] sm:min-h-[52px]">LEER</div>
            </div>
            <div class="text-[9px] text-[var(--text-muted)] uppercase tracking-wider text-right">Eigene Feldzone (Pilot A):</div>
          </div>

        </div>

        <!-- Pilot A (Hero Beat) Status Bar -->
        <div class="p-3 rounded border border-[var(--border-hairline)] bg-[var(--bg-card)] space-y-2">
          <div class="flex justify-between items-center text-[10px]">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span class="font-bold text-[var(--text-primary)]">PILOT A (HERO BEAT)</span>
              <span class="text-[var(--text-muted)]">[P1]</span>
            </div>
            <div class="font-mono text-sm font-bold text-[var(--text-primary)]" id="edison-lp-p1">4,000 LP</div>
          </div>
          <!-- LP Bar -->
          <div class="w-full h-2 bg-[var(--bg-secondary)] rounded-full overflow-hidden border border-[var(--border-hairline)]">
            <div id="edison-lp-bar-p1" class="h-full bg-emerald-500 transition-all duration-300" style="width: 50%;"></div>
          </div>
          <!-- Hand Cards Representation -->
          <div class="pt-1 flex items-center justify-between text-[10px] text-[var(--text-muted)]">
            <span>HAND: 2 KARTEN</span>
            <div class="flex gap-1.5">
              <span class="px-1.5 py-0.5 rounded border border-[var(--border-hairline)] bg-[var(--bg-secondary)] text-[var(--text-primary)]">Honest</span>
              <span class="px-1.5 py-0.5 rounded border border-[var(--border-hairline)] bg-[var(--bg-secondary)] text-[var(--text-primary)]">Miracle Fusion</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Right: Chain Link Inspector & Referee Audit Trail -->
      <div class="w-full md:w-[420px] border-t md:border-t-0 md:border-l border-[var(--border-hairline)] bg-[var(--bg-secondary)] p-4 flex flex-col justify-between overflow-y-auto space-y-4">
        
        <!-- Step-by-Step Chain Link Stack -->
        <div class="space-y-3">
          <div class="flex justify-between items-center text-[10px] text-[var(--text-muted)] uppercase tracking-wider font-bold">
            <span>LIFO-Ketten-Stack (Chain Link):</span>
            <span id="edison-step-counter" class="text-[var(--text-primary)]">SCHRITT 3 / 4</span>
          </div>

          <!-- Chain Stack Items (Reverse Order: CL3 at top, then CL2, then CL1) -->
          <div class="space-y-2">
            <!-- CL3 -->
            <div id="stack-cl3" class="p-2.5 rounded border border-cyan-500/40 bg-cyan-500/10 space-y-1 transition-all">
              <div class="flex justify-between text-[10px] font-bold">
                <span class="text-cyan-600 dark:text-cyan-400">CL 3 // SOLEMN JUDGMENT</span>
                <span class="text-[9px] text-[var(--text-muted)]">PILOT A [COUNTER]</span>
              </div>
              <p class="text-[10px] text-[var(--text-secondary)] leading-relaxed">
                Pilot A zahlt die Hälfte der Lebenspunkte (8000 &rarr; 4000 LP). Negiert die Aktivierung von Starlight Road und zerstört die Karte.
              </p>
            </div>

            <!-- CL2 -->
            <div id="stack-cl2" class="p-2.5 rounded border border-amber-500/40 bg-amber-500/10 space-y-1 transition-all">
              <div class="flex justify-between text-[10px] font-bold">
                <span class="text-amber-600 dark:text-amber-400">CL 2 // STARLIGHT ROAD</span>
                <span class="text-[9px] text-[var(--text-muted)]">PILOT B [TRAP]</span>
              </div>
              <p class="text-[10px] text-[var(--text-secondary)] leading-relaxed">
                Aktiviert als Reaktion auf Heavy Storm (Zerstörung von 2+ Karten). Versucht Heavy Storm zu negieren und Stardust Dragon zu beschwören.
              </p>
            </div>

            <!-- CL1 -->
            <div id="stack-cl1" class="p-2.5 rounded border border-emerald-500/40 bg-emerald-500/10 space-y-1 transition-all">
              <div class="flex justify-between text-[10px] font-bold">
                <span class="text-emerald-600 dark:text-emerald-400">CL 1 // HEAVY STORM</span>
                <span class="text-[9px] text-[var(--text-muted)]">PILOT A [SPELL]</span>
              </div>
              <p class="text-[10px] text-[var(--text-secondary)] leading-relaxed">
                Initiale Aktivierung. Zerstört alle Zauber- und Fallenkarten auf dem gesamten Spielfeld.
              </p>
            </div>
          </div>

          <!-- Step Progression Controls -->
          <div class="pt-2 flex items-center justify-between gap-2">
            <button id="edison-btn-prev" class="px-3 py-1.5 rounded border border-[var(--border-hairline)] hover:border-[var(--text-primary)] bg-[var(--bg-card)] text-[10px] font-bold text-[var(--text-primary)] transition-all cursor-pointer">
              &larr; VORHERIGE
            </button>
            <button id="edison-btn-auto" class="px-3 py-1.5 rounded border border-[var(--text-primary)] bg-[var(--text-primary)] text-[var(--bg-primary)] text-[10px] font-bold transition-all cursor-pointer flex-1">
              &rtrif; LIFO AUFLÖSEN
            </button>
            <button id="edison-btn-next" class="px-3 py-1.5 rounded border border-[var(--border-hairline)] hover:border-[var(--text-primary)] bg-[var(--bg-card)] text-[10px] font-bold text-[var(--text-primary)] transition-all cursor-pointer">
              NÄCHSTE &rarr;
            </button>
          </div>
        </div>

        <!-- Section: Deterministic OCGCore State-Machine & Rule Verification -->
        <div class="p-3 rounded border border-[var(--border-hairline)] bg-[var(--bg-card)] space-y-2.5">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span class="text-[10px] text-[var(--text-muted)] uppercase tracking-wider font-bold">
                OCGCORE STATE-MACHINE // REGEL-VERIFIKATION:
              </span>
            </div>
            <div id="edison-engine-badge" class="px-2 py-0.5 rounded font-mono text-[9px] font-bold border border-emerald-500/30 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
              DISPATCH: VALID (&lt; 0.5 ms)
            </div>
          </div>

          <!-- Deterministic Rule Mechanics Grid -->
          <div class="grid grid-cols-2 gap-2 text-[9px]">
            <div class="p-2 rounded border border-[var(--border-hairline)] bg-[var(--bg-secondary)] space-y-1">
              <div class="text-[var(--text-muted)] uppercase font-bold text-[8px]">SPELL SPEED / PRIORITÄT:</div>
              <div id="edison-spell-speed" class="font-bold text-[var(--text-primary)]">SPELL SPEED 3 [KONTERFALLE]</div>
              <div id="edison-spell-speed-desc" class="text-[var(--text-secondary)] text-[8px] leading-tight">Höchste Kettenstufe. Nur Konterfallen können anketten.</div>
            </div>
            <div class="p-2 rounded border border-[var(--border-hairline)] bg-[var(--bg-secondary)] space-y-1">
              <div class="text-[var(--text-muted)] uppercase font-bold text-[8px]">KDE TIEBREAKER (TIME-CALL):</div>
              <div id="edison-time-call-status" class="font-bold text-amber-600 dark:text-amber-400">TURN 2 VON 3 AKTIV</div>
              <div id="edison-time-call-desc" class="text-[var(--text-secondary)] text-[8px] leading-tight">Höhere LP bei Turn-3-Ende entscheidet Match sofort.</div>
            </div>
          </div>

          <!-- Rule Mechanics Explanation -->
          <div class="p-2.5 rounded border border-[var(--border-hairline)] bg-[var(--bg-secondary)] space-y-1">
            <div class="text-[9px] font-bold text-[var(--text-primary)] uppercase tracking-wider flex items-center gap-1">
              <span>⚖</span> REGELWERK-FORENSIK (APRIL 2010 STAND):
            </div>
            <p id="edison-rule-explanation" class="text-[9px] sm:text-[10px] text-[var(--text-secondary)] leading-relaxed">
              ...
            </p>
          </div>
        </div>

        <!-- Section: Immutable Referee Audit Trail Log -->
        <div class="p-3 rounded border border-[var(--border-hairline)] bg-[var(--bg-card)] space-y-2">
          <div class="text-[10px] text-[var(--text-muted)] uppercase tracking-wider font-bold">
            Referee Audit-Trail (SQLite Log):
          </div>
          <div id="edison-audit-log" class="font-mono text-[9px] text-[var(--text-secondary)] space-y-1 max-h-24 overflow-y-auto">
            <div><span class="text-[var(--text-muted)]">17:14:01</span> [CL1] Heavy Storm deklariert.</div>
            <div><span class="text-[var(--text-muted)]">17:14:03</span> [CL2] Starlight Road gechaint.</div>
            <div><span class="text-[var(--text-muted)]">17:14:07</span> [CL3] Solemn Judgment gechaint (LP: 8000 &rarr; 4000).</div>
            <div><span class="text-emerald-500 font-bold">17:14:10</span> [RESOLVE] CL3 negiert CL2. CL1 zerstört Backrow.</div>
          </div>
        </div>

        <!-- Call to Action Launchpad -->
        <div class="pt-2 border-t border-[var(--border-hairline)] space-y-2">
          <a 
            href="https://play.aethelburg.network" 
            target="_blank" 
            rel="noreferrer"
            class="w-full py-2 px-3 rounded border border-amber-600 bg-amber-600/10 hover:bg-amber-600 text-amber-600 hover:text-white dark:text-amber-400 dark:hover:text-black font-bold text-center block transition-all shadow-sm"
          >
            VOLLSTÄNDIGE STORE-PLATTFORM ÖFFNEN &nearr;
          </a>
          <div class="text-[9px] text-[var(--text-muted)] text-center">
            Läuft live auf server-141 // C++ OCGCore via WebAssembly
          </div>
        </div>

      </div>

    </div>

    <!-- Modal Footer -->
    <div class="px-5 py-2.5 border-t border-[var(--border-hairline)] bg-[var(--bg-secondary)] text-[10px] text-[var(--text-muted)] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2">
      <div class="flex items-center gap-3">
        <span class="font-bold text-[var(--text-primary)]">CORE:</span>
        <span class="font-mono">WASM OCGCORE // KRYPTOGRAPHISCHER REFEREE AUDIT TRAIL // PRE-FLIGHT BANLIST</span>
      </div>
      <div>
        <span>TASTATUR: [&larr;/&rarr;] SCHRITTE | [LEERTASTE] AUFLÖSEN | [G] GOD-MODE | [ESC] SCHLIESSEN</span>
      </div>
    </div>

  </div>
</div>

<script>
  function initEdisonReplayModal() {
    const modal = document.getElementById('edison-replay-modal');
    const closeBtn = document.getElementById('edison-close-btn');
    const fogBtn = document.getElementById('edison-fog-btn');
    const fogLabel = document.getElementById('edison-fog-label');
    const fogLed = document.getElementById('edison-fog-led');

    const btnPrev = document.getElementById('edison-btn-prev');
    const btnNext = document.getElementById('edison-btn-next');
    const btnAuto = document.getElementById('edison-btn-auto');
    const stepCounter = document.getElementById('edison-step-counter');
    const chainSummary = document.getElementById('edison-chain-summary');

    const lpP1 = document.getElementById('edison-lp-p1');
    const lpP2 = document.getElementById('edison-lp-p2');
    const lpBarP1 = document.getElementById('edison-lp-bar-p1');
    const lpBarP2 = document.getElementById('edison-lp-bar-p2');

    const stackCl1 = document.getElementById('stack-cl1');
    const stackCl2 = document.getElementById('stack-cl2');
    const stackCl3 = document.getElementById('stack-cl3');
    const cardHeavy = document.getElementById('card-heavystorm');
    const cardStarlight = document.getElementById('card-starlight');
    const cardSolemn = document.getElementById('card-solemn');
    const revealCards = document.querySelectorAll('.card-reveal');

    // Deterministic OCGCore Rule Forensics DOM Handles
    const engineBadge = document.getElementById('edison-engine-badge');
    const spellSpeed = document.getElementById('edison-spell-speed');
    const spellSpeedDesc = document.getElementById('edison-spell-speed-desc');
    const timeCallStatus = document.getElementById('edison-time-call-status');
    const timeCallDesc = document.getElementById('edison-time-call-desc');
    const ruleExplanation = document.getElementById('edison-rule-explanation');

    if (!modal) return;

    let isGodMode = true;
    let currentStep = 3; // 0: Init, 1: CL1, 2: CL2, 3: CL3, 4: Resolved
    const maxSteps = 4;

    const STEPS = [
      {
        name: 'SCHRITT 0 / 4: AUSGANGSLAGE',
        p1Lp: 8000,
        p2Lp: 3400,
        summary: 'KETTE LEER // MAIN PHASE 1 (TURN 2)',
        cl1Active: false,
        cl2Active: false,
        cl3Active: false,
        resolved: false,
        engineBadge: 'OCGCORE: IDLE (< 0.2 ms)',
        engineBadgeClass: 'border-cyan-500/30 bg-cyan-500/10 text-cyan-600 dark:text-cyan-400',
        spellSpeed: 'PRIORITÄT BEI TURN-SPIELER',
        spellSpeedDesc: 'Pilot A (Hero Beat) besitzt das Recht zur ersten Aktion in Main Phase 1.',
        timeCallStatus: 'TURN 2 VON 3 AKTIV',
        timeCallDesc: 'Offizielle KDE-Tiebreaker-Runde läuft. 4-Zug-Limit nach Time-Call.',
        explanation: 'Ausgangssituation: Pilot A kontrolliert Stratos & Alius auf dem Feld. Pilot B besitzt 2 verdeckte Backrow-Karten und 2 Synchromonster. Die C++ OCGCore State-Machine wartet auf eine legale Spieler-Eingabe (MSG_SELECT_IDLECMD).'
      },
      {
        name: 'SCHRITT 1 / 4: CL1 DEKLARIERT',
        p1Lp: 8000,
        p2Lp: 3400,
        summary: '1 KETTENGLIED // AKTIV: CL1 HEAVY STORM',
        cl1Active: true,
        cl2Active: false,
        cl3Active: false,
        resolved: false,
        engineBadge: 'DISPATCH: CHAIN_OPEN (< 0.4 ms)',
        engineBadgeClass: 'border-emerald-500/30 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400',
        spellSpeed: 'SPELL SPEED 1 [NORMALE ZAUBER]',
        spellSpeedDesc: 'Startet Kette. Priorität zur Reaktion geht automatisch an Pilot B.',
        timeCallStatus: 'TURN 2 VON 3 AKTIV',
        timeCallDesc: 'Kettenbildungs-Phase. OCGCore übergibt MSG_SELECT_CHAIN an Seat 1.',
        explanation: 'Heavy Storm wird aktiviert (CL1). Regelmechanisch wechselt die Reaktions-Priorität an Pilot B. Um eine normale Zauberkarte (Spell Speed 1) zu kontern, muss mindestens eine Karte mit Spell Speed 2 (Schnellzauber / Normale Falle) angekettet werden.'
      },
      {
        name: 'SCHRITT 2 / 4: CL2 GECHAINT',
        p1Lp: 8000,
        p2Lp: 3400,
        summary: '2 KETTENGLIEDER // AKTIV: CL2 STARLIGHT ROAD',
        cl1Active: true,
        cl2Active: true,
        cl3Active: false,
        resolved: false,
        engineBadge: 'TRIGGER: ACTIVATION LEGAL (< 0.3 ms)',
        engineBadgeClass: 'border-amber-500/30 bg-amber-500/10 text-amber-600 dark:text-amber-400',
        spellSpeed: 'SPELL SPEED 2 [NORMALE FALLE]',
        spellSpeedDesc: 'Legal aktiviert: Bedingung erfüllt (Heavy Storm zerstört 2+ Karten).',
        timeCallStatus: 'TURN 2 VON 3 AKTIV',
        timeCallDesc: 'Priorität wechselt zurück an Pilot A. Erfordert Spell Speed 2 oder 3.',
        explanation: 'Pilot B chaint Starlight Road (CL2). Die Aktivierungsbedingung ist legal, da Heavy Storm 2+ Karten zerstören würde. Priorität wechselt zurück an Pilot A. Da CL2 Spell Speed 2 ist, kann Pilot A nur mit Spell Speed 2 (z. B. Schnellzauber) oder Konterfallen (Spell Speed 3) reagieren.'
      },
      {
        name: 'SCHRITT 3 / 4: CL3 COUNTER (DECISION POINT)',
        p1Lp: 4000,
        p2Lp: 3400,
        summary: '3 KETTENGLIEDER // AKTIV: CL3 SOLEMN JUDGMENT',
        cl1Active: true,
        cl2Active: true,
        cl3Active: true,
        resolved: false,
        engineBadge: 'RESOLVE: COST DEDUCTION OK (< 0.4 ms)',
        engineBadgeClass: 'border-cyan-500/30 bg-cyan-500/10 text-cyan-600 dark:text-cyan-400',
        spellSpeed: 'SPELL SPEED 3 [KONTERFALLE]',
        spellSpeedDesc: 'Höchste Kettenstufe im Spiel. Kann nur durch Spell Speed 3 gekontert werden.',
        timeCallStatus: 'TURN 2: 4000 LP > 3400 LP',
        timeCallDesc: 'Kosten (50% LP = -4000) deterministisch abgebucht. Pilot A bleibt in Führung.',
        explanation: 'Solemn Judgment (CL3) wird aktiviert: Pilot A zahlt exakt die Hälfte der aktuellen Lebenspunkte (8000 → 4000 LP). Als Konterfalle (Spell Speed 3) sperrt Solemn Judgment das Kettenende für alle Karten unter Speed 3. Pilot B kann nicht reagieren (keine Konterfalle verfügbar).'
      },
      {
        name: 'SCHRITT 4 / 4: LIFO AUFGELÖST',
        p1Lp: 4000,
        p2Lp: 3400,
        summary: 'KETTE BEENDET // CL3 NEGIERT CL2 &rarr; CL1 ERFOLGREICH',
        cl1Active: false,
        cl2Active: false,
        cl3Active: false,
        resolved: true,
        engineBadge: 'LIFO RESOLVED // AUDIT LOGGED (< 0.5 ms)',
        engineBadgeClass: 'border-emerald-500/30 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400',
        spellSpeed: 'RÜCKWÄRTS-AUFLÖSUNG (LIFO)',
        spellSpeedDesc: 'CL3 negiert & zerstört CL2. CL1 zerstört restliche Backrow.',
        timeCallStatus: 'TURN 3 TRANSITION READY',
        timeCallDesc: 'Feld bereinigt. Pilot A führt mit 4000 zu 3400 LP. Sieg nach Turn 3 gesichert.',
        explanation: 'Deterministische Stack-Auflösung nach LIFO-Prinzip: 1. CL3 resolvt: Negiert die Aktivierung von Starlight Road und zerstört sie (kein Stardust Dragon). 2. CL2 negiert: Kein Effekt. 3. CL1 resolvt: Heavy Storm zerstört die restliche gegnerische Backrow. Referee-Audit-Trail loggt den Zustand atomar in SQLite.'
      }
    ];

    function renderStep(idx: number) {
      currentStep = idx;
      const s = STEPS[idx];

      if (stepCounter) stepCounter.textContent = s.name;
      if (chainSummary) chainSummary.innerHTML = s.summary;

      // Update Life Points
      if (lpP1) lpP1.textContent = `${s.p1Lp.toLocaleString()} LP`;
      if (lpP2) lpP2.textContent = `${s.p2Lp.toLocaleString()} LP`;
      if (lpBarP1) lpBarP1.style.width = `${(s.p1Lp / 8000) * 100}%`;
      if (lpBarP2) lpBarP2.style.width = `${(s.p2Lp / 8000) * 100}%`;

      // Highlight Stacks
      if (stackCl1) stackCl1.style.opacity = s.cl1Active || s.resolved ? '1' : '0.35';
      if (stackCl2) stackCl2.style.opacity = s.cl2Active ? '1' : '0.35';
      if (stackCl3) stackCl3.style.opacity = s.cl3Active ? '1' : '0.35';

      // Field Highlights
      if (cardHeavy) cardHeavy.style.opacity = s.cl1Active ? '1' : (s.resolved ? '0.4' : '0.8');
      if (cardStarlight) cardStarlight.style.opacity = s.cl2Active ? '1' : (s.resolved ? '0.2' : '0.8');
      if (cardSolemn) cardSolemn.style.opacity = s.cl3Active ? '1' : (s.resolved ? '0.2' : '0.8');

      // Update Deterministic Engine Telemetry
      if (engineBadge) {
        engineBadge.textContent = s.engineBadge;
        engineBadge.className = `px-2 py-0.5 rounded font-mono text-[9px] font-bold border ${s.engineBadgeClass}`;
      }
      if (spellSpeed) spellSpeed.textContent = s.spellSpeed;
      if (spellSpeedDesc) spellSpeedDesc.textContent = s.spellSpeedDesc;
      if (timeCallStatus) timeCallStatus.textContent = s.timeCallStatus;
      if (timeCallDesc) timeCallDesc.textContent = s.timeCallDesc;
      if (ruleExplanation) ruleExplanation.textContent = s.explanation;
    }

    function toggleFogOfWar() {
      isGodMode = !isGodMode;
      if (fogLabel) fogLabel.textContent = isGodMode ? 'GOD-MODE: UNMASKED' : 'POV: PILOT A (FOG OF WAR)';
      if (fogLed) {
        fogLed.className = isGodMode 
          ? 'w-1.5 h-1.5 rounded-full bg-cyan-500' 
          : 'w-1.5 h-1.5 rounded-full bg-amber-500';
      }

      revealCards.forEach(c => {
        if (isGodMode) {
          c.classList.remove('opacity-20', 'blur-[2px]');
          c.textContent = c.getAttribute('data-real-name') || c.textContent;
        } else {
          c.setAttribute('data-real-name', c.textContent || '');
          c.textContent = '??? [FACE-DOWN]';
          c.classList.add('opacity-50');
        }
      });
    }

    fogBtn?.addEventListener('click', toggleFogOfWar);

    btnPrev?.addEventListener('click', () => {
      if (currentStep > 0) renderStep(currentStep - 1);
    });

    btnNext?.addEventListener('click', () => {
      if (currentStep < maxSteps) renderStep(currentStep + 1);
    });

    let autoInterval: any = null;
    btnAuto?.addEventListener('click', () => {
      if (autoInterval) {
        clearInterval(autoInterval);
        autoInterval = null;
        if (btnAuto) btnAuto.textContent = '▶ LIFO AUFLÖSEN';
        return;
      }
      renderStep(0);
      if (btnAuto) btnAuto.textContent = '⏸ ANHALTEN';
      autoInterval = setInterval(() => {
        if (currentStep < maxSteps) {
          renderStep(currentStep + 1);
        } else {
          clearInterval(autoInterval);
          autoInterval = null;
          if (btnAuto) btnAuto.textContent = '⟲ WIEDERHOLEN';
        }
      }, 1200);
    });

    // Visibility
    let isOpen = false;
    function open() {
      isOpen = true;
      modal.classList.remove('opacity-0', 'pointer-events-none');
      renderStep(3);
    }

    function close() {
      isOpen = false;
      modal.classList.add('opacity-0', 'pointer-events-none');
      if (autoInterval) {
        clearInterval(autoInterval);
        autoInterval = null;
      }
    }

    closeBtn?.addEventListener('click', close);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) close();
    });

    window.addEventListener('open-edison-replay', () => open());

    window.addEventListener('keydown', (e) => {
      if (!isOpen) return;
      if (e.key === 'Escape') close();
      if (e.key === 'g' || e.key === 'G') toggleFogOfWar();
      if (e.key === 'ArrowLeft') {
        if (currentStep > 0) renderStep(currentStep - 1);
      }
      if (e.key === 'ArrowRight') {
        if (currentStep < maxSteps) renderStep(currentStep + 1);
      }
      if (e.code === 'Space') {
        e.preventDefault();
        btnAuto?.click();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEdisonReplayModal);
  } else {
    initEdisonReplayModal();
  }
</script>
