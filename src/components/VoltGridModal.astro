---
// VoltGridModal.astro - Cyber-Physical 3-Phase Continuous Phasor & Symbolic Verification Sandbox
import ProjectIcon from './ProjectIcon.astro';
---

<div id="volt-grid-modal" class="fixed inset-0 z-50 bg-black/70 backdrop-blur-md flex items-center justify-center p-3 sm:p-6 opacity-0 pointer-events-none transition-opacity duration-300 font-mono-tech text-xs select-none">
  <div class="relative w-full max-w-6xl h-[92vh] bg-[var(--bg-primary)] border border-[var(--border-strong)] rounded-lg shadow-2xl overflow-hidden flex flex-col">
    
    <!-- Modal Header -->
    <div class="px-5 py-3 border-b border-[var(--border-hairline)] bg-[var(--bg-secondary)] flex items-center justify-between">
      <div class="flex items-center gap-3">
        <ProjectIcon id="volt" class="w-4 h-4 text-amber-400" />
        <span class="font-bold text-[var(--text-primary)] tracking-wide">AETHELBURG // VOLTGRID CYBER-PHYSICAL DYNAMICS</span>
        <span id="volt-regime-badge" class="text-[10px] text-[var(--text-muted)] hidden sm:inline">[MODE: 3-PHASE CONTINUOUS STATE SPACE]</span>
      </div>
      <div class="flex items-center gap-4">
        <div class="hidden md:flex items-center gap-3 text-[10px] text-[var(--text-muted)]">
          <span>f: <strong id="volt-freq-readout" class="text-[var(--text-primary)]">50.00 Hz</strong></span>
          <span>P: <strong id="volt-p-readout" class="text-cyan-500 font-bold">14.3 kW</strong></span>
          <span>u₂ (Schieflast): <strong id="volt-u2-readout" class="text-emerald-500 font-bold">1.2%</strong></span>
          <span>INGEST: <strong class="text-[var(--text-primary)]">SQLite-WAL (&lt;0.5ms)</strong></span>
        </div>
        <button id="volt-close-btn" class="px-2.5 py-1 rounded border border-[var(--border-hairline)] hover:border-[var(--text-primary)] text-[10px] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-all cursor-pointer">
          [SCHLIESSEN ✕]
        </button>
      </div>
    </div>

    <!-- Presets Bar (Physical Regimes) -->
    <div class="px-5 py-2 border-b border-[var(--border-hairline)] bg-[var(--bg-primary)] flex flex-wrap items-center gap-2">
      <span class="text-[10px] text-[var(--text-muted)] mr-1 uppercase">DYNAMISCHE REGIMES:</span>
      <button class="volt-preset-btn px-2.5 py-1 rounded text-[10px] font-mono-tech border border-[var(--text-primary)] bg-[var(--text-primary)] text-[var(--bg-primary)] font-bold transition-all cursor-pointer" data-preset="balanced">
        01 // SYMMETRISCH (BALANCED TN-S)
      </button>
      <button class="volt-preset-btn px-2.5 py-1 rounded text-[10px] font-mono-tech border border-[var(--border-hairline)] hover:border-[var(--text-primary)] bg-[var(--bg-card)] text-[var(--text-primary)] transition-all cursor-pointer" data-preset="inrush">
        02 // MOTORANLAUF TRANSIENTE (58A PEAK)
      </button>
      <button class="volt-preset-btn px-2.5 py-1 rounded text-[10px] font-mono-tech border border-[var(--border-hairline)] hover:border-[var(--text-primary)] bg-[var(--bg-card)] text-[var(--text-primary)] transition-all cursor-pointer" data-preset="asymmetry">
        03 // SCHIEFLAST &amp; ASYMMETRIE (FORTESCUE)
      </button>
      <button class="volt-preset-btn px-2.5 py-1 rounded text-[10px] font-mono-tech border border-[var(--border-hairline)] hover:border-[var(--text-primary)] bg-[var(--bg-card)] text-[var(--text-primary)] transition-all cursor-pointer" data-preset="leakage">
        04 // DIN VDE 0701 CONSTRAINT TRIP
      </button>
    </div>

    <!-- Main Workspace (Phasor Plane + Verification Deck) -->
    <div class="relative flex-1 w-full h-full overflow-y-auto lg:overflow-hidden flex flex-col lg:flex-row">
      
      <!-- Left: Complex Phasor Plane Canvas Stage -->
      <div class="relative w-full h-72 sm:h-88 lg:h-full lg:flex-1 shrink-0 bg-[var(--bg-primary)] overflow-hidden">
        <canvas id="volt-phasor-canvas" class="w-full h-full block cursor-crosshair"></canvas>

        <!-- Canvas In-Flight Telemetry Readout Box (Top-Left) -->
        <div class="pointer-events-none absolute top-3 left-3 bg-[var(--bg-card)] border border-[var(--border-hairline)] rounded p-2.5 backdrop-blur-sm space-y-1 text-[11px] shadow-lg">
          <div class="text-[var(--text-primary)] font-bold border-b border-[var(--border-hairline)] pb-1 flex items-center justify-between gap-4">
            <span>DREHSTROM-ZEIGERDIAGRAMM [ℂ]</span>
            <span class="text-[9px] text-[var(--text-muted)]">ROTATION: 50.0 Hz</span>
          </div>
          <div class="text-amber-500 font-mono">Phase L1: <span id="volt-l1-readout">230V ∠ 0° | 18.4A ∠ -23°</span></div>
          <div class="text-emerald-500 font-mono">Phase L2: <span id="volt-l2-readout">230V ∠ -120° | 17.8A ∠ -143°</span></div>
          <div class="text-cyan-500 font-mono">Phase L3: <span id="volt-l3-readout">230V ∠ +120° | 19.1A ∠ +97°</span></div>
          <div class="text-[var(--text-muted)] text-[10px] pt-1 border-t border-[var(--border-hairline)]">
            Fortescue: I₁: <span id="volt-i1-val" class="text-[var(--text-primary)]">18.4A</span> | I₂: <span id="volt-i2-val" class="text-rose-500">0.8A</span> | I₀: <span id="volt-i0-val">0.3A</span>
          </div>
        </div>

        <!-- Power Factor Gauge (Top-Right) -->
        <div class="pointer-events-none absolute top-3 right-3 bg-[var(--bg-card)] border border-[var(--border-hairline)] rounded p-2.5 backdrop-blur-sm text-[11px] min-w-[160px] shadow-lg">
          <div class="text-[var(--text-muted)] text-[10px] uppercase tracking-wider mb-1 flex justify-between">
            <span>Leistungsfaktor (cos φ)</span>
            <span id="volt-cosphi-val" class="text-[var(--text-primary)] font-bold">0.94</span>
          </div>
          <div class="w-full h-2 bg-[var(--bg-secondary)] rounded-full overflow-hidden border border-[var(--border-hairline)]">
            <div id="volt-cosphi-bar" class="h-full bg-cyan-500 transition-all duration-150" style="width: 94%;"></div>
          </div>
          <div class="flex justify-between text-[9px] text-[var(--text-muted)] mt-1">
            <span>P: <strong id="volt-p-sub" class="text-[var(--text-primary)]">12.8 kW</strong></span>
            <span>Q: <strong id="volt-q-sub" class="text-[var(--text-primary)]">4.6 kvar</strong></span>
          </div>
        </div>
      </div>

      <!-- Right: Cyber-Physical Verification & Ingest Inspector -->
      <div class="w-full lg:w-96 border-t lg:border-t-0 lg:border-l border-[var(--border-hairline)] bg-[var(--bg-secondary)] flex flex-col justify-between overflow-visible lg:overflow-y-auto p-4 sm:p-5 space-y-5 shrink-0">
        
        <!-- Section 1: Symbolic Constraint Solver -->
        <div class="space-y-3">
          <div class="text-[10px] font-mono-tech uppercase tracking-wider text-[var(--text-muted)] border-b border-[var(--border-hairline)] pb-1.5 flex justify-between">
            <span>DIN VDE 0701-0702 VERIFIER</span>
            <span class="text-cyan-500 font-bold">FORMAL GATE</span>
          </div>
          
          <div class="space-y-2 text-xs">
            <div class="p-2.5 rounded bg-[var(--bg-card)] border border-[var(--border-hairline)]">
              <div class="flex justify-between font-bold mb-1">
                <span>R_PE (Schutzleiter):</span>
                <span id="vde-rpe-status" class="text-emerald-500">0.14 Ω [OK &le; 0.30]</span>
              </div>
              <div class="w-full bg-[var(--bg-primary)] h-1.5 rounded-full overflow-hidden">
                <div id="vde-rpe-bar" class="h-full bg-emerald-500 transition-all" style="width: 46%;"></div>
              </div>
            </div>

            <div class="p-2.5 rounded bg-[var(--bg-card)] border border-[var(--border-hairline)]">
              <div class="flex justify-between font-bold mb-1">
                <span>R_ISO (Isolation):</span>
                <span id="vde-riso-status" class="text-emerald-500">120 MΩ [OK &ge; 1.0]</span>
              </div>
              <div class="w-full bg-[var(--bg-primary)] h-1.5 rounded-full overflow-hidden">
                <div id="vde-riso-bar" class="h-full bg-emerald-500 transition-all" style="width: 90%;"></div>
              </div>
            </div>

            <div class="p-2.5 rounded bg-[var(--bg-card)] border border-[var(--border-hairline)]">
              <div class="flex justify-between font-bold mb-1">
                <span>I_EA (Ersatzableitstrom):</span>
                <span id="vde-iea-status" class="text-emerald-500">0.22 mA [OK &le; 3.5]</span>
              </div>
              <div class="w-full bg-[var(--bg-primary)] h-1.5 rounded-full overflow-hidden">
                <div id="vde-iea-bar" class="h-full bg-emerald-500 transition-all" style="width: 6%;"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Section 2: Mathematical Foundation -->
        <div class="space-y-2">
          <div class="text-[10px] font-mono-tech uppercase tracking-wider text-[var(--text-muted)] border-b border-[var(--border-hairline)] pb-1.5">
            Fortescue Transformation (Asymmetrie)
          </div>
          <p class="text-[11px] text-[var(--text-secondary)] leading-relaxed">
            Die Schieflast-Zerlegung isoliert das Gegensystem <span class="font-mono text-rose-400">I₂</span> aus dem komplexen Drehstromvektor:
          </p>
          <div class="p-2 rounded bg-[var(--bg-card)] border border-[var(--border-hairline)] font-mono text-[10px] text-[var(--text-primary)]">
            I₂ = ⅓ (I_L1 + a²·I_L2 + a·I_L3)<br/>
            u₂ = |I₂ / I₁| · 100% &le; 2.0%
          </div>
        </div>

        <!-- Section 3: Live Node Trigger -->
        <div class="pt-3 border-t border-[var(--border-hairline)] space-y-2">
          <div class="text-[10px] font-mono-tech uppercase tracking-wider text-[var(--text-muted)]">
            Produktions-Knoten &amp; SQLite Studio
          </div>
          <a href="https://volt.aethelburg.network" target="_blank" rel="noreferrer" class="w-full py-2.5 px-4 rounded bg-[var(--text-primary)] hover:opacity-90 text-[var(--bg-primary)] font-mono-tech text-xs font-bold transition-all flex items-center justify-center gap-2 cursor-pointer shadow-md">
            <span>VOLTGRID EDGE NODE ÖFFNEN</span>
            <span>↗</span>
          </a>
          <span class="text-[10px] text-[var(--text-muted)] text-center block">
            Target Host: volt.aethelburg.network
          </span>
        </div>

      </div>
    </div>

  </div>
</div>

<script>
  function initVoltGridModal() {
    const modal = document.getElementById('volt-grid-modal');
    const closeBtn = document.getElementById('volt-close-btn');
    const canvas = document.getElementById('volt-phasor-canvas') as HTMLCanvasElement;
    if (!modal || !canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let isOpen = false;
    let animId = 0;
    let angle = 0;

    // Grid State
    let state = {
      u1: 230, u2: 230, u3: 230,
      i1: 18.4, i2: 17.8, i3: 19.1,
      cosPhi: 0.94,
      freq: 50.00,
      phi1: 0,
      phi2: -2 * Math.PI / 3,
      phi3: 2 * Math.PI / 3,
      rPe: 0.14,
      rIso: 120.0,
      iEa: 0.22,
      regime: 'balanced'
    };

    function open() {
      isOpen = true;
      modal?.classList.remove('opacity-0', 'pointer-events-none');
      resize();
      startLoop();
    }

    function close() {
      isOpen = false;
      modal?.classList.add('opacity-0', 'pointer-events-none');
      cancelAnimationFrame(animId);
    }

    window.addEventListener('open-volt-grid', open);
    closeBtn?.addEventListener('click', close);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) close();
    });
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) close();
    });

    // Resize
    let w = 0, h = 0;
    function resize() {
      const dpr = window.devicePixelRatio || 1;
      const rect = canvas.getBoundingClientRect();
      w = rect.width;
      h = rect.height;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    window.addEventListener('resize', () => { if (isOpen) resize(); });

    // Presets
    const presetBtns = document.querySelectorAll('.volt-preset-btn');
    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        presetBtns.forEach(b => {
          b.classList.remove('border-[var(--text-primary)]', 'bg-[var(--text-primary)]', 'text-[var(--bg-primary)]', 'font-bold');
          b.classList.add('border-[var(--border-hairline)]', 'bg-[var(--bg-card)]', 'text-[var(--text-primary)]');
        });
        btn.classList.add('border-[var(--text-primary)]', 'bg-[var(--text-primary)]', 'text-[var(--bg-primary)]', 'font-bold');
        btn.classList.remove('border-[var(--border-hairline)]', 'bg-[var(--bg-card)]', 'text-[var(--text-primary)]');

        const p = btn.getAttribute('data-preset');
        applyPreset(p || 'balanced');
      });
    });

    function applyPreset(p: string) {
      state.regime = p;
      if (p === 'balanced') {
        state.u1 = 230; state.u2 = 230; state.u3 = 230;
        state.i1 = 18.4; state.i2 = 17.8; state.i3 = 19.1;
        state.phi1 = 0; state.phi2 = -2 * Math.PI / 3; state.phi3 = 2 * Math.PI / 3;
        state.cosPhi = 0.94; state.freq = 50.00;
        state.rPe = 0.14; state.rIso = 120.0; state.iEa = 0.22;
      } else if (p === 'inrush') {
        state.u1 = 221; state.u2 = 229; state.u3 = 230;
        state.i1 = 58.4; state.i2 = 14.2; state.i3 = 16.0;
        state.phi1 = 0; state.phi2 = -2 * Math.PI / 3 - 0.08; state.phi3 = 2 * Math.PI / 3 + 0.05;
        state.cosPhi = 0.65; state.freq = 49.95;
        state.rPe = 0.16; state.rIso = 110.0; state.iEa = 0.28;
      } else if (p === 'asymmetry') {
        state.u1 = 244; state.u2 = 232; state.u3 = 198;
        state.i1 = 6.2; state.i2 = 4.8; state.i3 = 42.5;
        state.phi1 = 0; state.phi2 = -2 * Math.PI / 3 + 0.18; state.phi3 = 2 * Math.PI / 3 - 0.25;
        state.cosPhi = 0.88; state.freq = 50.01;
        state.rPe = 0.15; state.rIso = 95.0; state.iEa = 0.35;
      } else if (p === 'leakage') {
        // Massive DIN VDE Constraint Trip: Phase 1 insulation collapse / ground leakage fault!
        state.u1 = 168; state.u2 = 246; state.u3 = 242;
        state.i1 = 48.6; state.i2 = 11.2; state.i3 = 13.5;
        state.phi1 = 0.35; state.phi2 = -2 * Math.PI / 3 - 0.22; state.phi3 = 2 * Math.PI / 3 + 0.15;
        state.cosPhi = 0.52; state.freq = 49.88;
        state.rPe = 0.85; // FAILS DIN VDE (> 0.30 Ohm)
        state.rIso = 0.35; // FAILS DIN VDE (< 1.0 MOhm)
        state.iEa = 4.20; // FAILS DIN VDE (> 3.50 mA)
      }
      updateDomReadouts();
    }

    function updateDomReadouts() {
      // Math: P = (U1*I1 + U2*I2 + U3*I3)*cosPhi / 1000
      const pTotal = ((state.u1 * state.i1 + state.u2 * state.i2 + state.u3 * state.i3) * state.cosPhi) / 1000;
      const sinPhi = Math.sqrt(Math.max(0, 1 - state.cosPhi * state.cosPhi));
      const qTotal = ((state.u1 * state.i1 + state.u2 * state.i2 + state.u3 * state.i3) * sinPhi) / 1000;

      // Fortescue Exact Calculation (Symmetrical Components)
      const cosA = -0.5;
      const sinA = Math.sqrt(3) / 2;

      const c1x = state.i1 * Math.cos(state.phi1 || 0);
      const c1y = state.i1 * Math.sin(state.phi1 || 0);
      const c2x = state.i2 * Math.cos(state.phi2 !== undefined ? state.phi2 : -2 * Math.PI / 3);
      const c2y = state.i2 * Math.sin(state.phi2 !== undefined ? state.phi2 : -2 * Math.PI / 3);
      const c3x = state.i3 * Math.cos(state.phi3 !== undefined ? state.phi3 : 2 * Math.PI / 3);
      const c3y = state.i3 * Math.sin(state.phi3 !== undefined ? state.phi3 : 2 * Math.PI / 3);

      // a * c2
      const ac2x = cosA * c2x - sinA * c2y;
      const ac2y = sinA * c2x + cosA * c2y;
      // a^2 * c3
      const a2c3x = cosA * c3x + sinA * c3y;
      const a2c3y = -sinA * c3x + cosA * c3y;

      const i1x = (c1x + ac2x + a2c3x) / 3;
      const i1y = (c1y + ac2y + a2c3y) / 3;
      const i1Mag = Math.hypot(i1x, i1y);

      // a^2 * c2
      const a2c2x = cosA * c2x + sinA * c2y;
      const a2c2y = -sinA * c2x + cosA * c2y;
      // a * c3
      const ac3x = cosA * c3x - sinA * c3y;
      const ac3y = sinA * c3x + cosA * c3y;

      const i2x = (c1x + a2c2x + ac3x) / 3;
      const i2y = (c1y + a2c2y + ac3y) / 3;
      const i2Mag = Math.hypot(i2x, i2y);

      const i0x = (c1x + c2x + c3x) / 3;
      const i0y = (c1y + c2y + c3y) / 3;
      const i0Mag = Math.hypot(i0x, i0y);

      const u2Percent = (i2Mag / Math.max(0.1, i1Mag)) * 100;

      // Update Header
      const fEl = document.getElementById('volt-freq-readout');
      const pEl = document.getElementById('volt-p-readout');
      const u2El = document.getElementById('volt-u2-readout');
      const rBadge = document.getElementById('volt-regime-badge');

      if (fEl) fEl.textContent = `${state.freq.toFixed(2)} Hz`;
      if (pEl) pEl.textContent = `${pTotal.toFixed(1)} kW`;
      if (u2El) {
        u2El.textContent = `${u2Percent.toFixed(1)}%`;
        u2El.className = u2Percent > 5.0 ? 'text-rose-500 font-bold' : 'text-emerald-500 font-bold';
      }
      if (rBadge) {
        if (state.regime === 'leakage') {
          rBadge.textContent = '[TRIP: DIN VDE 0701 DEFECT DETECTED]';
          rBadge.className = 'text-[10px] text-rose-500 font-bold animate-pulse hidden sm:inline';
        } else if (state.regime === 'asymmetry') {
          rBadge.textContent = '[ALERT: UNBALANCED FORTESCUE LOAD]';
          rBadge.className = 'text-[10px] text-rose-400 font-bold hidden sm:inline';
        } else if (state.regime === 'inrush') {
          rBadge.textContent = '[TRANSIENT: HIGH-CURRENT INRUSH]';
          rBadge.className = 'text-[10px] text-amber-400 font-bold hidden sm:inline';
        } else {
          rBadge.textContent = '[MODE: 3-PHASE CONTINUOUS STATE SPACE]';
          rBadge.className = 'text-[10px] text-[var(--text-muted)] hidden sm:inline';
        }
      }

      // Gauges
      const pSub = document.getElementById('volt-p-sub');
      const qSub = document.getElementById('volt-q-sub');
      const cosVal = document.getElementById('volt-cosphi-val');
      const cosBar = document.getElementById('volt-cosphi-bar');
      if (pSub) pSub.textContent = `${pTotal.toFixed(1)} kW`;
      if (qSub) qSub.textContent = `${qTotal.toFixed(1)} kvar`;
      if (cosVal) cosVal.textContent = state.cosPhi.toFixed(2);
      if (cosBar) cosBar.style.width = `${state.cosPhi * 100}%`;

      // Readouts
      const l1El = document.getElementById('volt-l1-readout');
      const l2El = document.getElementById('volt-l2-readout');
      const l3El = document.getElementById('volt-l3-readout');
      const deg1 = Math.round(((state.phi1 || 0) * 180) / Math.PI);
      const deg2 = Math.round(((state.phi2 !== undefined ? state.phi2 : -2 * Math.PI / 3) * 180) / Math.PI);
      const deg3 = Math.round(((state.phi3 !== undefined ? state.phi3 : 2 * Math.PI / 3) * 180) / Math.PI);
      const phiDeg = Math.round((Math.acos(Math.min(1, Math.max(-1, state.cosPhi))) * 180) / Math.PI);
      const iDeg1 = deg1 - phiDeg;
      const iDeg2 = deg2 - phiDeg;
      const iDeg3 = deg3 - phiDeg;

      if (l1El) l1El.textContent = `${state.u1.toFixed(0)}V ∠ ${deg1}° | ${state.i1.toFixed(1)}A ∠ ${iDeg1}°`;
      if (l2El) l2El.textContent = `${state.u2.toFixed(0)}V ∠ ${deg2}° | ${state.i2.toFixed(1)}A ∠ ${iDeg2}°`;
      if (l3El) l3El.textContent = `${state.u3.toFixed(0)}V ∠ ${deg3}° | ${state.i3.toFixed(1)}A ∠ ${iDeg3}°`;

      const i1El = document.getElementById('volt-i1-val');
      const i2El = document.getElementById('volt-i2-val');
      const i0El = document.getElementById('volt-i0-val');
      if (i1El) i1El.textContent = `${i1Mag.toFixed(1)}A`;
      if (i2El) {
        i2El.textContent = `${i2Mag.toFixed(1)}A`;
        i2El.className = i2Mag > 5.0 ? 'text-rose-500 font-bold' : 'text-emerald-500';
      }
      if (i0El) {
        i0El.textContent = `${i0Mag.toFixed(1)}A`;
        i0El.className = i0Mag > 3.0 ? 'text-rose-500 font-bold' : 'text-[var(--text-muted)]';
      }

      // DIN VDE Verification Gates
      const rpeStat = document.getElementById('vde-rpe-status');
      const rpeBar = document.getElementById('vde-rpe-bar');
      if (rpeStat && rpeBar) {
        if (state.rPe <= 0.30) {
          rpeStat.textContent = `${state.rPe.toFixed(2)} Ω [OK ≤ 0.30]`;
          rpeStat.className = 'text-emerald-500';
          rpeBar.className = 'h-full bg-emerald-500 transition-all';
          rpeBar.style.width = `${(state.rPe / 0.30) * 50}%`;
        } else {
          rpeStat.textContent = `${state.rPe.toFixed(2)} Ω [VERLETZT > 0.30]`;
          rpeStat.className = 'text-rose-500 font-bold';
          rpeBar.className = 'h-full bg-rose-500 transition-all';
          rpeBar.style.width = '100%';
        }
      }

      const risoStat = document.getElementById('vde-riso-status');
      const risoBar = document.getElementById('vde-riso-bar');
      if (risoStat && risoBar) {
        if (state.rIso >= 1.0) {
          risoStat.textContent = `${state.rIso.toFixed(1)} MΩ [OK ≥ 1.0]`;
          risoStat.className = 'text-emerald-500';
          risoBar.className = 'h-full bg-emerald-500 transition-all';
          risoBar.style.width = `${Math.min(100, (state.rIso / 100) * 100)}%`;
        } else {
          risoStat.textContent = `${state.rIso.toFixed(2)} MΩ [VERLETZT < 1.0]`;
          risoStat.className = 'text-rose-500 font-bold';
          risoBar.className = 'h-full bg-rose-500 transition-all';
          risoBar.style.width = '20%';
        }
      }

      const ieaStat = document.getElementById('vde-iea-status');
      const ieaBar = document.getElementById('vde-iea-bar');
      if (ieaStat && ieaBar) {
        if (state.iEa <= 3.50) {
          ieaStat.textContent = `${state.iEa.toFixed(2)} mA [OK ≤ 3.5]`;
          ieaStat.className = 'text-emerald-500';
          ieaBar.className = 'h-full bg-emerald-500 transition-all';
          ieaBar.style.width = `${(state.iEa / 3.50) * 50}%`;
        } else {
          ieaStat.textContent = `${state.iEa.toFixed(2)} mA [VERLETZT > 3.5]`;
          ieaStat.className = 'text-rose-500 font-bold';
          ieaBar.className = 'h-full bg-rose-500 transition-all';
          ieaBar.style.width = '100%';
        }
      }
    }

    // Animation Loop (Continuous Rotating Phasor in Complex Plane)
    function startLoop() {
      function render() {
        if (!isOpen) return;
        angle += 0.02; // Rotation delta

        ctx.clearRect(0, 0, w, h);
        const cx = w / 2;
        const cy = h / 2;
        const maxRadius = Math.min(w, h) * 0.38;

        // 1. Draw Grid Circles (Complex Coordinate Mesh)
        ctx.strokeStyle = 'rgba(128, 128, 128, 0.15)';
        ctx.lineWidth = 1;
        for (let r = 0.25; r <= 1.0; r += 0.25) {
          ctx.beginPath();
          ctx.arc(cx, cy, maxRadius * r, 0, Math.PI * 2);
          ctx.stroke();
        }

        // 2. Real & Imaginary Axis
        ctx.beginPath();
        ctx.moveTo(cx - maxRadius * 1.1, cy);
        ctx.lineTo(cx + maxRadius * 1.1, cy);
        ctx.moveTo(cx, cy - maxRadius * 1.1);
        ctx.lineTo(cx, cy + maxRadius * 1.1);
        ctx.stroke();

        ctx.fillStyle = 'rgba(128, 128, 128, 0.4)';
        ctx.font = '9px monospace';
        ctx.fillText('Re (+)', cx + maxRadius * 1.05, cy - 5);
        ctx.fillText('Im (+j)', cx + 5, cy - maxRadius * 1.05);

        // Angles for L1, L2, L3 (incorporating dynamic phase shifts)
        const a1 = angle + (state.phi1 !== undefined ? state.phi1 : 0);
        const a2 = angle + (state.phi2 !== undefined ? state.phi2 : -2 * Math.PI / 3);
        const a3 = angle + (state.phi3 !== undefined ? state.phi3 : 2 * Math.PI / 3);
        const phi = Math.acos(Math.min(1.0, Math.max(-1.0, state.cosPhi)));

        // Helper to draw vector
        function drawVector(theta: number, magFrac: number, color: string, label: string, isDashed: boolean = false) {
          const len = maxRadius * magFrac;
          const ex = cx + Math.cos(theta) * len;
          const ey = cy + Math.sin(theta) * len;

          ctx.strokeStyle = color;
          ctx.fillStyle = color;
          ctx.lineWidth = isDashed ? 1.5 : 2.5;
          if (isDashed) ctx.setLineDash([4, 4]);
          else ctx.setLineDash([]);

          ctx.beginPath();
          ctx.moveTo(cx, cy);
          ctx.lineTo(ex, ey);
          ctx.stroke();
          ctx.setLineDash([]);

          // Arrow head
          const headLen = 7;
          const arrowAngle = Math.PI / 7;
          ctx.beginPath();
          ctx.moveTo(ex, ey);
          ctx.lineTo(ex - headLen * Math.cos(theta - arrowAngle), ey - headLen * Math.sin(theta - arrowAngle));
          ctx.lineTo(ex - headLen * Math.cos(theta + arrowAngle), ey - headLen * Math.sin(theta + arrowAngle));
          ctx.fill();

          // Text label
          ctx.font = 'bold 11px monospace';
          ctx.fillText(label, ex + Math.cos(theta) * 12, ey + Math.sin(theta) * 12);
        }

        // Draw Voltages (scaled to 230V nominal)
        const lenU1 = Math.min(1.0, (state.u1 / 230.0) * 0.82);
        const lenU2 = Math.min(1.0, (state.u2 / 230.0) * 0.82);
        const lenU3 = Math.min(1.0, (state.u3 / 230.0) * 0.82);

        drawVector(a1, lenU1, '#f59e0b', `U_L1 (${state.u1}V)`);
        drawVector(a2, lenU2, '#10b981', `U_L2 (${state.u2}V)`);
        drawVector(a3, lenU3, '#06b6d4', `U_L3 (${state.u3}V)`);

        // Draw Currents (Phase Lag phi)
        const iScale = 1.0 / 60.0; // scale relative to 60A
        drawVector(a1 - phi, Math.min(1.0, state.i1 * iScale), '#d97706', `I_L1 (${state.i1.toFixed(1)}A)`, true);
        drawVector(a2 - phi, Math.min(1.0, state.i2 * iScale), '#059669', `I_L2 (${state.i2.toFixed(1)}A)`, true);
        drawVector(a3 - phi, Math.min(1.0, state.i3 * iScale), '#0891b2', `I_L3 (${state.i3.toFixed(1)}A)`, true);

        // Sternpunktverschiebung / Neutral Point Displacement: U_N = (U1 + U2 + U3) / 3
        const uNx = (state.u1 * Math.cos(a1) + state.u2 * Math.cos(a2) + state.u3 * Math.cos(a3)) / 3.0;
        const uNy = (state.u1 * Math.sin(a1) + state.u2 * Math.sin(a2) + state.u3 * Math.sin(a3)) / 3.0;
        const magUn = Math.hypot(uNx, uNy);

        if (magUn >= 2.5) {
          const thetaUn = Math.atan2(uNy, uNx);
          const lenUnFrac = Math.min(0.85, (magUn / 230.0) * 2.8);
          drawVector(thetaUn, lenUnFrac, '#f43f5e', `ΔU_N (${magUn.toFixed(1)}V)`, true);

          ctx.fillStyle = '#f43f5e';
          ctx.font = 'bold 11px monospace';
          const alertText = state.regime === 'leakage' 
            ? `⚡ DIN VDE CONSTRAINT TRIP! R_PE=${state.rPe.toFixed(2)}Ω, ΔU_N=${magUn.toFixed(1)}V`
            : `⚡ SCHIEFLAST-WARNUNG: ΔU_N = ${magUn.toFixed(1)}V (u₂ > 2%)`;
          ctx.fillText(alertText, cx - maxRadius * 0.95, cy + maxRadius * 0.98);
        }

        animId = requestAnimationFrame(render);
      }
      render();
    }

    updateDomReadouts();
  }

  // Auto-init on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVoltGridModal);
  } else {
    initVoltGridModal();
  }
</script>
