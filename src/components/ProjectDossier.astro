---
// ProjectDossier.astro - Minimalist Dutch Editorial Slide-Over Dossier
---

<div id="dossier-backdrop" class="fixed inset-0 bg-black/40 backdrop-blur-sm z-50 opacity-0 pointer-events-none transition-opacity duration-300" style="transform: translateZ(0); will-change: opacity; backface-visibility: hidden;"></div>

<aside id="dossier-panel" class="fixed top-0 right-0 bottom-0 w-full max-w-xl bg-[var(--bg-primary)] border-l border-[var(--border-hairline)] z-50 translate-x-full transition-transform duration-300 ease-out flex flex-col justify-between shadow-2xl overflow-y-auto">
  <!-- Dossier Header -->
  <div class="p-6 sm:p-8 border-b border-[var(--border-hairline)] flex items-start justify-between">
    <div class="flex items-start gap-3.5">
      <div id="dossier-icon" class="w-10 h-10 rounded border border-[var(--border-hairline)] bg-[var(--bg-card)] flex items-center justify-center p-2 text-[var(--text-primary)] shrink-0 mt-0.5 shadow-sm">
        <!-- Dynamically injected ProjectIcon -->
      </div>
      <div>
        <div id="dossier-index" class="text-[11px] font-mono-tech uppercase tracking-widest text-[var(--text-muted)]">
          DOSSIER // 01
        </div>
        <h2 id="dossier-title" class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--text-primary)] mt-0.5">
          ARC-AGI-3 Solver
        </h2>
        <p id="dossier-sub" class="text-xs font-editorial text-[var(--text-secondary)] mt-1 text-base">
          Autonomous Causal Graph Search & Fluid Intelligence
        </p>
      </div>
    </div>
    <button id="dossier-close-btn" class="px-3 py-1.5 rounded border border-[var(--border-hairline)] hover:border-[var(--text-primary)] text-xs font-mono-tech text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-all">
      [ESC // SCHLIESSEN]
    </button>
  </div>

  <!-- Dossier Body Content -->
  <div class="p-6 sm:p-8 space-y-8 flex-1">
    <!-- Key Empirical Metrics -->
    <div>
      <div class="text-[10px] font-mono-tech uppercase tracking-wider text-[var(--text-muted)] mb-3">
        Empirische Leistungsdaten (Hard Facts)
      </div>
      <div id="dossier-metrics" class="grid grid-cols-2 gap-3 font-mono-tech text-xs">
        <!-- Injected via JS -->
      </div>
    </div>

    <!-- Architectural Deep Dive -->
    <div class="space-y-3">
      <div class="text-[10px] font-mono-tech uppercase tracking-wider text-[var(--text-muted)]">
        Architektur & Kern-Ingenieursleistung
      </div>
      <div id="dossier-body" class="text-xs text-[var(--text-secondary)] leading-relaxed space-y-3">
        <!-- Injected via JS -->
      </div>
    </div>

    <!-- Interactive Demo Trigger Button (ARC Scrubber etc.) -->
    <div id="dossier-interactive-container" class="hidden">
      <button id="dossier-interactive-btn" class="w-full py-2.5 px-4 rounded border-2 border-emerald-500 bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 font-mono-tech text-xs font-bold transition-all flex items-center justify-center gap-2 cursor-pointer shadow-sm">
        <span>▶</span>
        <span id="dossier-interactive-label">INTERAKTIVEN TRAJEKTORIE-SCRUBBER STARTEN</span>
      </button>
    </div>

    <!-- Verification & Deployment Links: Dual Action Buttons -->
    <div class="pt-4 border-t border-[var(--border-hairline)] space-y-2">
      <div class="text-[10px] font-mono-tech uppercase tracking-wider text-[var(--text-muted)]">
        Verifikation &amp; Deployment
      </div>
      <div class="flex flex-col sm:flex-row items-stretch gap-2.5">
        <!-- Live System Link (Primary) -->
        <a id="dossier-live-link" href="#" target="_blank" rel="noreferrer" class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded bg-[var(--text-primary)] text-[var(--bg-primary)] font-mono-tech text-xs font-bold hover:opacity-90 transition-opacity text-center shadow-xs">
          <span id="dossier-live-label">LIVE DEPLOYMENT</span>
          <span>↗</span>
        </a>
        <!-- GitHub Repo Link (Secondary / Code Audit) -->
        <a id="dossier-repo-link" href="#" target="_blank" rel="noreferrer" class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded border border-[var(--border-strong)] bg-[var(--bg-card)] hover:border-[var(--text-primary)] text-[var(--text-primary)] font-mono-tech text-xs font-bold transition-all text-center shadow-xs">
          <span id="dossier-repo-label">GITHUB REPO</span>
          <span>↗</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Dossier Footer -->
  <div class="px-6 py-4 border-t border-[var(--border-hairline)] bg-[var(--bg-secondary)] flex items-center justify-between text-[10px] font-mono-tech text-[var(--text-muted)]">
    <span>SYSTEM: AETHELBURG // AUTONOMOUS NODE</span>
    <span>STATUS: EMPIRICALLY VERIFIED</span>
  </div>
</aside>

<script>
  interface DossierData {
    index: string;
    title: string;
    sub: string;
    metrics: { label: string; value: string }[];
    paragraphs: string[];
    liveLink?: string | null;
    liveLabel?: string;
    repoLink: string;
    repoLabel?: string;
  }

  const DOSSIERS: Record<string, DossierData> = {
    arc: {
      index: 'DOSSIER // 01 - FRONTIER AI',
      title: 'ARC-AGI-3 Sovereign Solver',
      sub: 'Domain-Agnostische Kausale Weltmodelle & PSPACE-Graphensuche',
      metrics: [
        { label: 'Evaluation', value: '25 Offizielle ARC-3 Spiele' },
        { label: 'Verifizierte Level', value: 'lp85, ls20 L0-1, tn36' },
        { label: 'Live Interface', value: 'WebSocket Solver Bridge' },
        { label: 'Kaggle Bundle', value: '0.94 MB (Zero Internet)' }
      ],
      paragraphs: [
        'Ein autonomer Solver für die offizielle ARC-AGI-3 Challenge (François Chollet / Abstraction & Reasoning Corpus). Statt auf statistische LLMs oder starre Heuristiken zu setzen, operiert das System über kausale Affordance-Detektion, Connected-Component-Zentroide und diskrete PSPACE-Graphensuche.',
        'Die Konsole bietet einen dualen Modus: Über die integrierte WebSocket-Bridge streamt der echte Python-Solver (SovereignARC3Agent) seine Aktionen und kausalen Inferenzen Schritt für Schritt live in den Browser; offline steht ein forensischer Trajektorien-Scrubber zur Verfügung.',
        'Läuft vollständig offline innerhalb des 12-stündigen Kaggle-Budgets ohne Internetzugriff.'
      ],
      liveLink: 'https://www.kaggle.com/competitions/arc-prize-2026',
      liveLabel: 'KAGGLE ENVIRONMENT',
      repoLink: 'https://github.com/aethelnet/arc-solver',
      repoLabel: 'ARC-3 REPOSITORY'
    },
    museum: {
      index: 'DOSSIER // 02 - FORENSIC MULTIGRAPH & RESTITUTION',
      title: 'Project Echo (Shadow Museum Atlas)',
      sub: 'Evidenz-Multigraphen, Epistemische 4-Stufen-Gewichtung & On-Chain Notarisierung',
      metrics: [
        { label: 'Gesamt-Corpus', value: '2.178 Knoten // 6.629 Kanten' },
        { label: 'Epistemische Dissonanz', value: '2.052 Widersprüche evaluiert' },
        { label: 'On-Chain Notarisierung', value: 'TheForge Merkle-Root & ERC-4337' },
        { label: 'Live-System', value: 'echo.aethelburg.network' }
      ],
      paragraphs: [
        'Ein dezentrales forensisches Analyse- und Provenienz-System zur visuellen und juristischen Rekonstruktion historischer Raubgut-Trajektorien (Project Echo) und Whistleblower-Netzwerke.',
        'Verknüpft Primärquellen, Archiv-Inventare und Expeditionsberichte in einem kontinuierlich gewichteten Multigraphen. Ein epistemischer 4-Stufen-Evaluator löst Widersprüche mathematisch auf (Tier 1 Primärarchive vs. Tier 4 Museumsnarrative) und emittiert strukturierte ActionEvents bei Deadlocks.',
        'Dossier-Abschlüsse werden deterministisch als Merkle-Root gehasht und über das Aethelnet-Substrat via gasless Account Abstraction (ERC-4337 Paymaster) manipulationssicher on-chain notarisiert.'
      ],
      liveLink: 'https://echo.aethelburg.network',
      liveLabel: 'PROJECT ECHO ATLAS',
      repoLink: 'https://github.com/aethelnet/project-echo',
      repoLabel: 'MULTIGRAPH REPO'
    },
    edison: {
      index: 'DOSSIER // 03 - DETERMINISTIC STATE MACHINE',
      title: 'Edison Store Engine (WASM)',
      sub: 'WASM OCGCore Duel Simulator & Store Locals Platform',
      metrics: [
        { label: 'Engine Core', value: 'C++ OCGCore via WebAssembly' },
        { label: 'Turn Latency', value: '< 0.5 ms pro Dispatch' },
        { label: 'Production URL', value: 'play.aethelburg.network' },
        { label: 'Audit Trail', value: 'Kryptographisch unveränderlich' }
      ],
      paragraphs: [
        'Vollständige Produktionsplattform für Yu-Gi-Oh Edison-Format-Turniere mit echter Game-State-Verifikation im Browser. Ausgestattet mit Pre-Flight-Banlist-Gates, automatischer Runden-Sirene und KDE-Tiebreaker-Automation (Turns 0–3).',
        'Inklusive Standalone Edge-Launcher (scripts/launch_store_locals.sh) für lokale Store-Turniere ohne Internetabhängigkeit und Cloud-Delta-Sync zum Hauptnetzwerk.'
      ],
      liveLink: 'https://play.aethelburg.network',
      liveLabel: 'DUEL SIMULATOR',
      repoLink: 'https://github.com/aethelnet/ygo-edison',
      repoLabel: 'WASM ENGINE REPO'
    },
    lgnn: {
      index: 'DOSSIER // 04 - DYNAMICAL SYSTEMS',
      title: 'Liquid Neural Core',
      sub: 'Zeitkontinuierliche Nichtlineare Differenzialgleichungen',
      metrics: [
        { label: 'Synapsen-Modell', value: 'LiquidNode dh/dt = -h/τ(u) + W' },
        { label: 'Relaxation τ0', value: '10.0s (Adaptive Fluidität)' },
        { label: 'Integrator', value: '4th-Order Runge-Kutta (RK4)' },
        { label: 'Live Observer', value: 'aethelburg.network' }
      ],
      paragraphs: [
        'Mathematische Implementierung von Liquid Neural Networks (zeitkontinuierliche ODEs mit adaptiver Viskosität tau(u)). Entwickelt für latenzarme Zeitreihenanalyse und dynamische Zustandsschätzung unter hochgradig nichtstationären Bedingungen.',
        'Das System fungiert als Inferenzkern für Aethelnet-Knoten und passt seine Gedächtnisabklingzeit kontinuierlich an: In stabilen Phasen filtert Trägheit Rauschen heraus; bei Phasenübergängen und Schocks bricht tau(u) zusammen und triggert sofortige Reaktionsdynamik.'
      ],
      liveLink: 'https://aethelburg.network',
      liveLabel: 'NEURAL MANIFOLD',
      repoLink: 'https://github.com/aethelnet/aethelnet-node',
      repoLabel: 'LGNN NODE REPO'
    },
    volt: {
      index: 'DOSSIER // 05 - CYBER-PHYSICAL SYSTEMS',
      title: 'VoltGrid Cyber-Physical Core',
      sub: 'Kontinuierliche 3-Phasen-Dynamik, Fortescue-Transformation & DIN VDE Constraint Solver',
      metrics: [
        { label: 'Phasor Decomposition', value: 'Fortescue Symmetrische Komponenten' },
        { label: 'Verification Engine', value: 'Symbolische DIN VDE 0701-0702 Schranken' },
        { label: 'High-Speed Ingest', value: 'SQLite WAL Mode (< 0.5 ms Query)' },
        { label: 'Edge Deployment', value: 'volt.aethelburg.network' }
      ],
      paragraphs: [
        'Ein cyber-physikalisches Modellierungs- und Verifikationssystem für dreiphasige Drehstrom-Verteilernetze (TN-S/TN-C-S). Verknüpft zeitkontinuierliche Vektorfelder in der komplexen Ebene mit deterministischer Sicherheitsverifikation nach europäischen Normen.',
        'Das System zerlegt asymmetrische Phasenströme in Echtzeit mittels Fortescue-Transformation in Mit-, Gegen- und Nullsysteme (I₁, I₂, I₀), um Schieflasten und thermische Überlastungen von Neutralleitern prädiktiv zu detektieren.',
        'Die Verifikations-Engine prüft elektrotechnische Betriebsmittel formal gegen parametrische Sicherheitsgrenzwerte (Schutzleiter- und Isolationswiderstände unter dynamischen Leitungslängenzuschlägen) und archiviert manipulationssichere Audit-Trails in einer hochperformanten WAL-Datenbank.'
      ],
      liveLink: 'https://volt.aethelburg.network',
      liveLabel: 'VOLTGRID STUDIO',
      repoLink: 'https://github.com/aethelnet/volt-grid',
      repoLabel: 'VOLTGRID REPO'
    },
    audio: {
      index: 'DOSSIER // 06 - SYSTEMS ARCHITECTURE & DSP',
      title: 'Audio Engine Core',
      sub: 'C++20 Real-Time DSP, Lock-Free Streaming & Plugin Delay Compensation',
      metrics: [
        { label: 'CTest Suite', value: '59 / 59 Passed (100%)' },
        { label: 'Real-Time Safety', value: 'Zero Heap Alloc / Zero Mutex' },
        { label: 'PDC Engine', value: 'Bit-Exakte Phasen-Kompensation' },
        { label: 'WASM Studio', value: 'audio.aethelburg.network' }
      ],
      paragraphs: [
        'Eine hochperformante, echtzeitfähige C++20 Digital Signal Processing (DSP) Engine für latenzkritische Workstations und Audio-Server. Garantiert strikt null Heap-Allokationen und null blockierende Mutexes innerhalb des Audio-Render-Callbacks.',
        'Verfügt über automatische Plugin Delay Compensation (PDC) mittels Ringpuffer-Verzögerungsleitungen zur vollständigen Eliminierung von Phasenauslöschungen sowie kontinuierliches Sample-Accurate Parameter Ramping (vektorisierte lineare FMA-Interpolation) gegen Klick- und Reißverschluss-Artefakte.',
        'Integrierte analoge DSP-Emulationen basieren auf den Algorithmen von Chris Johnson (Airwindows) — darunter Baxandall-EQ, ButterComp2, PurestDrive, DeRez2, ClipOnly2 und Interstage — adaptiert für latenzfreie C++20 Vektorarchitektur.',
        'Inklusive asynchroner Disk-Streaming-Engine mit latenzfreiem RAM-Pre-Roll-Header (0.0 ms Ansprechzeit) und lock-freiem SPSC-Ringpuffer-Prefetching sowie einer Golden-Master-Prüfsummensuite zur bit-exakten Verifikation aller Signalpfade.'
      ],
      liveLink: 'https://audio.aethelburg.network',
      liveLabel: 'C++ WASM STUDIO',
      repoLink: 'https://github.com/aethelnet/audio-engine-core',
      repoLabel: 'C++ REPOSITORY'
    }
  };

  function initProjectDossier() {
    const backdrop = document.getElementById('dossier-backdrop');
    const panel = document.getElementById('dossier-panel');
    const closeBtn = document.getElementById('dossier-close-btn');

    const dIndex = document.getElementById('dossier-index');
    const dTitle = document.getElementById('dossier-title');
    const dSub = document.getElementById('dossier-sub');
    const dMetrics = document.getElementById('dossier-metrics');
    const dBody = document.getElementById('dossier-body');
    const dIcon = document.getElementById('dossier-icon');
    const dLiveLink = document.getElementById('dossier-live-link') as HTMLAnchorElement | null;
    const dLiveLabel = document.getElementById('dossier-live-label');
    const dRepoLink = document.getElementById('dossier-repo-link') as HTMLAnchorElement | null;
    const dRepoLabel = document.getElementById('dossier-repo-label');
    const interactiveContainer = document.getElementById('dossier-interactive-container');
    const interactiveBtn = document.getElementById('dossier-interactive-btn');

    const ICONS: Record<string, string> = {
      arc: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="w-6 h-6 text-emerald-500" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="1.5" stroke-width="1.5"/><path d="M9 3v18M15 3v18M3 9h18M3 15h18" stroke-width="0.75" stroke-dasharray="1.5 2" stroke-opacity="0.6"/><rect x="9" y="9" width="6" height="6" fill="currentColor" fill-opacity="0.25" stroke-width="1.5"/><circle cx="12" cy="12" r="1.5" fill="currentColor"/></svg>`,
      museum: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="w-6 h-6 text-amber-500" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="6" r="4.5" stroke-width="0.75" stroke-dasharray="2 2" stroke-opacity="0.5"/><path d="M7.8 16.2L10.8 7.8M13.2 7.8L16.2 16.2M8.5 18h7" stroke-width="1.25"/><circle cx="6" cy="18" r="2.5" stroke-width="1.5"/><circle cx="18" cy="18" r="2.5" stroke-width="1.5"/><circle cx="12" cy="6" r="2.5" stroke-width="1.5" fill="currentColor" fill-opacity="0.3"/></svg>`,
      edison: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="w-6 h-6 text-cyan-500" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2.5 20.5 7.5 20.5 16.5 12 21.5 3.5 16.5 3.5 7.5" stroke-width="1.5"/><path d="M12 7.5v9M7.5 10l9 4M7.5 14l9-4" stroke-width="0.9" stroke-opacity="0.7"/><circle cx="12" cy="12" r="2" fill="currentColor"/></svg>`,
      lgnn: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="w-6 h-6 text-purple-500" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" stroke-width="0.75" stroke-dasharray="2 2" stroke-opacity="0.5"/><path d="M12 3a9 9 0 0 1 8.5 6M20.5 9l-3.5-.5M20.5 9l-1 3.5" stroke-width="1.5"/><path d="M3.5 15a9 9 0 0 0 14.5 3M18 18l-3.5.5M18 18l.5-3.5" stroke-width="1.5"/><circle cx="12" cy="12" r="2.5" stroke-width="1.25"/><circle cx="12" cy="12" r="1" fill="currentColor"/></svg>`,
      volt: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="w-6 h-6 text-amber-400" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" stroke-width="0.75" stroke-dasharray="2 2" stroke-opacity="0.5"/><path d="M12 12V3.5" stroke-width="1.75"/><path d="M12 12l7.36 4.25" stroke-width="1.75"/><path d="M12 12l-7.36 4.25" stroke-width="1.75"/><circle cx="12" cy="3.5" r="1.5" fill="currentColor"/><circle cx="19.36" cy="16.25" r="1.5" fill="currentColor"/><circle cx="4.64" cy="16.25" r="1.5" fill="currentColor"/><circle cx="12" cy="12" r="1.5" fill="currentColor"/></svg>`,
      audio: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="w-6 h-6 text-rose-500" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h20" stroke-width="0.75" stroke-dasharray="2 2" stroke-opacity="0.5"/><path d="M2 12c2.5-8 4-8 6.5 0s4 8 6.5 0c2-5 3.5-5 5 0" stroke-width="1.75"/><path d="M3 4.5h18M3 19.5h18" stroke-width="0.75" stroke-opacity="0.4"/><circle cx="8.5" cy="12" r="1.25" fill="currentColor"/><circle cx="15" cy="12" r="1.25" fill="currentColor"/></svg>`
    };

    function open(id: string) {
      const data = DOSSIERS[id];
      if (!data) return;

      if (dIcon && ICONS[id]) dIcon.innerHTML = ICONS[id];
      if (dIndex) dIndex.textContent = data.index;
      if (dTitle) dTitle.textContent = data.title;
      if (dSub) dSub.textContent = data.sub;

      if (dMetrics) {
        dMetrics.innerHTML = data.metrics.map(m => `
          <div class="p-2.5 rounded border border-[var(--border-hairline)] bg-[var(--bg-secondary)]">
            <div class="text-[10px] text-[var(--text-muted)] uppercase">${m.label}</div>
            <div class="font-bold text-[var(--text-primary)] mt-0.5">${m.value}</div>
          </div>
        `).join('');
      }

      if (dBody) {
        dBody.innerHTML = data.paragraphs.map(p => `<p>${p}</p>`).join('');
      }

      if (dLiveLink && dRepoLink) {
        if (data.liveLink) {
          dLiveLink.classList.remove('hidden');
          dLiveLink.href = data.liveLink;
          if (dLiveLabel) dLiveLabel.textContent = data.liveLabel || 'LIVE DEPLOYMENT';
          dRepoLink.className = "flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded border border-[var(--border-strong)] bg-[var(--bg-card)] hover:border-[var(--text-primary)] text-[var(--text-primary)] font-mono-tech text-xs font-bold transition-all text-center shadow-xs";
        } else {
          dLiveLink.classList.add('hidden');
          dRepoLink.className = "w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded bg-[var(--text-primary)] text-[var(--bg-primary)] font-mono-tech text-xs font-bold hover:opacity-90 transition-opacity text-center shadow-xs";
        }
        dRepoLink.href = data.repoLink;
        if (dRepoLabel) dRepoLabel.textContent = data.repoLabel || 'GITHUB REPO';
      }

      if (id === 'arc') {
        interactiveContainer?.classList.remove('hidden');
        const lbl = document.getElementById('dossier-interactive-label');
        if (lbl) lbl.textContent = 'INTERAKTIVEN TRAJEKTORIE-SCRUBBER STARTEN';
      } else if (id === 'museum') {
        interactiveContainer?.classList.remove('hidden');
        const lbl = document.getElementById('dossier-interactive-label');
        if (lbl) lbl.textContent = 'INTERAKTIVEN PROVENIENZ-GRAPHEN ÖFFNEN';
      } else if (id === 'edison') {
        interactiveContainer?.classList.remove('hidden');
        const lbl = document.getElementById('dossier-interactive-label');
        if (lbl) lbl.textContent = 'INTERAKTIVEN MATCH-FORENSIK-INSPECTOR STARTEN';
      } else if (id === 'lgnn') {
        interactiveContainer?.classList.remove('hidden');
        const lbl = document.getElementById('dossier-interactive-label');
        if (lbl) lbl.textContent = 'INTERAKTIVE LIQUID-ODE SANDBOX STARTEN';
      } else if (id === 'volt') {
        interactiveContainer?.classList.remove('hidden');
        const lbl = document.getElementById('dossier-interactive-label');
        if (lbl) lbl.textContent = 'INTERAKTIVES PHASENRAUM-DREHSTROM-LABOR STARTEN';
      } else if (id === 'audio') {
        interactiveContainer?.classList.remove('hidden');
        const lbl = document.getElementById('dossier-interactive-label');
        if (lbl) lbl.textContent = 'INTERAKTIVES ECHTZEIT-DSP-OSZILLOSKOP STARTEN';
      } else {
        interactiveContainer?.classList.add('hidden');
      }

      backdrop?.classList.remove('opacity-0', 'pointer-events-none');
      panel?.classList.remove('translate-x-full');
    }

    function close() {
      backdrop?.classList.add('opacity-0', 'pointer-events-none');
      panel?.classList.add('translate-x-full');
      window.dispatchEvent(new CustomEvent('close-dossier'));
    }

    let activeId = 'arc';
    window.addEventListener('open-dossier', (e: any) => {
      activeId = e.detail?.id || 'arc';
      open(activeId);
    });

    interactiveBtn?.addEventListener('click', () => {
      close();
      if (activeId === 'arc') {
        window.dispatchEvent(new CustomEvent('open-arc-scrubber'));
      } else if (activeId === 'museum') {
        window.dispatchEvent(new CustomEvent('open-museum-graph'));
      } else if (activeId === 'edison') {
        window.dispatchEvent(new CustomEvent('open-edison-replay'));
      } else if (activeId === 'lgnn') {
        window.dispatchEvent(new CustomEvent('open-lgnn-sandbox'));
      } else if (activeId === 'volt') {
        window.dispatchEvent(new CustomEvent('open-volt-grid'));
      } else if (activeId === 'audio') {
        window.dispatchEvent(new CustomEvent('open-audio-engine'));
      }
    });

    closeBtn?.addEventListener('click', close);
    backdrop?.addEventListener('click', close);
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProjectDossier);
  } else {
    initProjectDossier();
  }
</script>
